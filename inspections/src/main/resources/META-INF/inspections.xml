<idea-plugin allow-bundled-update="true">
    <resource-bundle>messages.CangJieInspectionsBundle</resource-bundle>
<!--    <resource-bundle>messages.CangJieBundle</resource-bundle>-->

    <extensions defaultExtensionNs="com.intellij">

        <localInspection language="CangJie" groupKey="cangjie"

                         enabledByDefault="true" level="ERROR"
                         implementationClass="com.huawei.cangjie.inspections.CjUnresolvedReferenceInspection"
                         key="inspection.cj.unresolved.reference.display.name"/>
    </extensions>

</idea-plugin>

