<idea-plugin>
    <!-- JPS 扩展配置 -->

    <!-- 启用 JPS 插件支持 -->
    <extensions defaultExtensionNs="com.intellij">
        <jps.plugin/>
    </extensions>

    <!-- 注册 JPS 模型序列化扩展 -->
    <extensions defaultExtensionNs="com.intellij.jps">
<!--        <modelSerializerExtension-->
<!--            implementation="org.cangnova.cangjie.config.CangJieJpsModelSerializerExtension"/>-->
    </extensions>

    <!-- IDE 层：源码根编辑处理器 -->
    <extensions defaultExtensionNs="com.intellij.projectStructure">
        <!-- 仓颉生产源代码根 -->
        <sourceRootEditHandler
            implementation="org.cangnova.cangjie.config.CangJieSourceRootEditHandler"/>

        <!-- 仓颉测试源代码根 -->
        <sourceRootEditHandler
            implementation="org.cangnova.cangjie.config.CangJieTestSourceRootEditHandler"/>

        <!-- 仓颉生产资源根 -->
        <sourceRootEditHandler
            implementation="org.cangnova.cangjie.config.CangJieResourceRootEditHandler"/>

        <!-- 仓颉测试资源根 -->
        <sourceRootEditHandler
            implementation="org.cangnova.cangjie.config.CangJieTestResourceRootEditHandler"/>
    </extensions>
</idea-plugin>
