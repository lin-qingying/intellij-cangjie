<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">


        <xdebugger.breakpointType
                implementation="org.cangnova.cangjie.debugger.protobuf.breakpoint.LineBreakpointType"
                order="first"/>

        <xdebugger.breakpointType
                implementation="org.cangnova.cangjie.debugger.protobuf.breakpoint.AddressBreakpointType"
        />


        <!--        <xdebugger.settings implementation="org.cangnova.cangjie.debugger.protobuf.settings.DebuggerSettings"/>-->

        <fileEditorProvider
                implementation="org.cangnova.cangjie.debugger.protobuf.memory.editor.MemoryViewFileEditorProvider"/>
        <readerModeMatcher
                implementation="org.cangnova.cangjie.debugger.protobuf.memory.editor.MemoryViewReaderModeMatcher"/>

        <!-- 虚拟文件系统 -->
        <virtualFileSystem
                key="cangjie_debugger_proto_memory"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.memory.vfs.MemoryViewVirtualFileSystem"/>

        <!-- 文件类型 -->
        <fileType
                name="CangJieMemoryHexdump"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.memory.vfs.HexdumpFileType"
                extensions="cj-hex"/>
        <fileType
                name="CangJieMemoryDisassembly"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.memory.vfs.DisasmFileType"
                extensions="cj-disasm"/>

        <!-- 语言支持 -->
        <lang.parserDefinition
                language="CangJieDebugProtoHexdump"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.memory.language.HexdumpParserDefinition"/>
        <lang.syntaxHighlighterFactory
                language="CangJieDebugProtoHexdump"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.memory.language.HexdumpSyntaxHighlighterFactory"/>
        <lang.foldingBuilder
                language="CangJieDebugProtoHexdump"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.memory.language.HexdumpFoldingBuilder"/>

        <!-- 输入处理 -->
        <typedHandler
                implementation="org.cangnova.cangjie.debugger.protobuf.memory.input.HexdumpTypedHandler"/>
        <typedHandler
                implementation="org.cangnova.cangjie.debugger.protobuf.memory.input.MemoryFileRawTypedHandler"/>


        <!-- 写入访问控制 -->
        <writingAccessProvider
                implementation="org.cangnova.cangjie.debugger.protobuf.memory.vfs.MemoryViewFileWritingAccessProvider"/>

        <editorTabTitleProvider
                implementation="org.cangnova.cangjie.debugger.protobuf.memory.editor.MemoryViewTabTitleProvider"/>

        <!-- LLDB 命令语言支持 -->
        <fileType
                name="CangJieDebugProtoLLDB"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.console.CangJieProtoLLDBFileType"
                language="CangJieDebugProtoLLDB"
                extensions="lldb"/>

        <lang.parserDefinition
                language="CangJieDebugProtoLLDB"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.console.CangJieLLDBParserDefinition"/>

        <completion.contributor
                language="CangJieDebugProtoLLDB"
                implementationClass="org.cangnova.cangjie.debugger.protobuf.console.CjdbConsoleCompletionContributor"/>


        <projectConfigurable instance="org.cangnova.cangjie.debugger.protobuf.settings.ProtoDebuggerConfigurable"
                             parentId="language.cangjie.debugger"
                             groupId="language.cangjie.debugger"
                             id="language.cangjie.debugger.protobuf"
                             bundle="messages.ProtoDebuggerBundle" key="proto.debug.title"/>

    </extensions>

    <actions>
        <!-- 内存视图导航 Action -->
        <action id="CangJie.Debug.Proto.MemoryView.GoToAddress"
                class="org.cangnova.cangjie.debugger.protobuf.memory.actions.GoToAddressAction"
                text="Go to Address..."
                description="Navigate to a specific memory address"
                icon="AllIcons.General.Locate">
            <!-- 快捷键：弹出地址输入对话框 -->
            <!--            <keyboard-shortcut first-keystroke="ctrl G" keymap="$default"/>-->
            <!-- 添加到内存视图编辑器的右键菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <!-- 复制地址 Action -->
        <action id="CangJie.Debug.Proto.MemoryView.CopyAddress"
                class="org.cangnova.cangjie.debugger.protobuf.memory.actions.CopyAddressAction"
                text="Copy Address"
                description="Copy current address to clipboard"
                icon="AllIcons.Actions.Copy">
            <!-- 使用 Ctrl+Shift+C 避免与默认复制冲突 -->
            <!--            <keyboard-shortcut first-keystroke="ctrl shift C" keymap="$default"/>-->
            <!-- 添加到编辑器右键菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="CangJie.Debug.Proto.MemoryView.GoToAddress"/>
            <!-- 添加到行号区域的右键菜单 -->
            <add-to-group group-id="EditorGutterPopupMenu" anchor="first"/>
        </action>

        <!-- 反汇编函数 Action -->
        <action id="CangJie.Debug.Proto.MemoryView.DisassembleFunction"
                class="org.cangnova.cangjie.debugger.protobuf.memory.actions.DisassembleFunctionAction"
                text="Disassemble Function"
                description="Disassemble function at selected address"
                icon="AllIcons.Debugger.Console">
            <!-- 添加到调试器栈帧上下文菜单 -->
            <add-to-group group-id="XDebugger.Frames.TopToolbar" anchor="after"
                          relative-to-action="XDebugger.Frames.TopToolbar"/>
            <!-- 添加到编辑器右键菜单（调试时可用） -->
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="CangJie.Debug.Proto.MemoryView.CopyAddress"/>
        </action>

        <!-- 查看内存 Action -->
        <action id="CangJie.Debug.Proto.MemoryView.ViewMemory"
                class="org.cangnova.cangjie.debugger.protobuf.memory.actions.ViewMemoryAction"
                text="View Memory"
                description="View memory at current frame address"
                icon="AllIcons.Debugger.Db_watch">
            <!-- 添加到调试器栈帧工具栏 -->
            <add-to-group group-id="XDebugger.Frames.TopToolbar" anchor="last"/>
            <!-- 添加到编辑器右键菜单 -->
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="CangJie.Debug.Proto.MemoryView.DisassembleFunction"/>
        </action>

        <!-- 调试器栈帧上下文菜单 -->
        <action id="CangJie.Debugger.Proto.DisassembleFrame"
                class="org.cangnova.cangjie.debugger.protobuf.memory.actions.DisassembleFunctionAction"
                text="Disassemble Function"
                description="Disassemble function at current frame">
            <add-to-group group-id="XDebugger.Frames.Tree.Popup" anchor="first"/>
        </action>

        <action id="CangJie.Debugger.Proto.ViewMemory"
                class="org.cangnova.cangjie.debugger.protobuf.memory.actions.ViewMemoryAction"
                text="View Memory"
                description="View memory at current frame address">
            <add-to-group group-id="XDebugger.Frames.Tree.Popup" anchor="after"
                          relative-to-action="CangJie.Debugger.Proto.DisassembleFrame"/>
        </action>
    </actions>


</idea-plugin>
