}

public enum Ordering {
    | LT
    | GT
    | EQ
}
public enum Option<T> {
    | Some(T)
    | None


    public func getOrThrow(): T
    public func getOrThrow(exception: () -> Exception): T
    public func getOrDefault(other: () -> T): T
    public func isNone(): Bool
    public func isSome(): Bool

}

