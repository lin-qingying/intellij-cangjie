<idea-plugin>

<resource-bundle />
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Enable Telemetry"
                           displayType="STICKY_BALLOON"
                           bundle="messages.TelemetryBundle"
                           key="notification.group.title.enable.telemetry"/>

        <!-- Telemetry Settings -->
        <applicationService serviceImplementation="org.cangnova.telemetry.TelemetrySettings"/>
        <applicationConfigurable
                parentId="tools"
                key="settings.telemetry.display.name"
                instance="org.cangnova.telemetry.ui.TelemetrySettingsPanel"
                id="org.cangnova.telemetry.settings"
                bundle="messages.TelemetryBundle"

        />

        <!-- Telemetry Services -->
        <applicationService serviceImplementation="org.cangnova.telemetry.data.TelemetryDataCollector"/>
        <applicationService serviceImplementation="org.cangnova.telemetry.sender.TelemetryDataSender"/>
        <applicationService serviceImplementation="org.cangnova.telemetry.impl.DefaultTelemetryService"
                            serviceInterface="org.cangnova.telemetry.api.TelemetryService"/>

        <!-- Startup Activities -->
        <postStartupActivity implementation="org.cangnova.telemetry.TelemetryStartupActivity"/>

        <!-- Notification Groups -->
        <notificationGroup id="CangJie.Telemetry"
                           displayType="BALLOON"
                           bundle="messages.TelemetryBundle"
                           key="notification.group.cangjie.title"/>
    </extensions>

    <actions>
        <!-- Add Telemetry Settings to the toolbar -->
        <action id="org.cangnova.telemetry.TelemetrySettingsAction"
                class="org.cangnova.telemetry.ui.TelemetrySettingsAction">
            <add-to-group group-id="MainToolBar" anchor="last"/>
        </action>

        <!-- Add Immediate Send Telemetry Action -->
        <action id="org.cangnova.telemetry.actions.SendImmediatelyTelemetryAction"
                class="org.cangnova.telemetry.actions.SendImmediatelyTelemetryAction">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>