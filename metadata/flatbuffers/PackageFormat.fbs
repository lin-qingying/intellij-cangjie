// 这是包格式定义文件
// This is actually a package format
namespace org.cangnova.cangjie.metadata.PackageFormat;

// 模块文件标识符
// Module
file_identifier "CJOF";

// 我们期望加载器重新构建符号表
// 但不重新进行类型推断/检查
// We expect the loader to redo the symbol table
// but not type inference / check within a loaded module

// 使用 uint32 作为 SemaTy/Decl/Expr 的表索引类型
// 0 是无效索引，有效索引从 1 开始，即表偏移量加 1
// 由于 AST 节点和 Ty 的大小，uint32 的长度足够，在溢出前会先发生内存不足
// Using 'uint32' as type of 'SemaTy/Decl/Expr' 's table index.
// 0 is invalid index, valid index start from 1, which is the offset of table plus 1.
// Because of the size of AST node and 'Ty', length of uint32 is enough that oom will occurred before out-of-range.
// 声明类型枚举
enum DeclKind : uint16 {
  InvalidDecl,       // 无效声明
  ClassDecl,         // 类声明
  InterfaceDecl,     // 接口声明
  FuncDecl,          // 函数声明
  PropDecl,          // 属性声明
  VarDecl,           // 变量声明
  VarWithPatternDecl,// 带模式的变量声明
  FuncParam,         // 函数参数
  StructDecl,        // 结构体声明
  EnumDecl,          // 枚举声明
  ExtendDecl,        // 扩展声明
  TypeAliasDecl,     // 类型别名声明
  GenericParamDecl,  // 泛型参数声明
  BuiltInDecl,       // 内置声明
}

// 位置成员的最大长度与 'struct Position' 的定义相同
// Position member's max length same as 'struct Position''s definition.
struct Position {
  file:uint32;   // 文件索引
  pkgId:uint32;  // 文件所属包的索引，0 表示当前包
  line:int32;    // 行号
  column:int32;  // 列号
  ignore:bool;   // 是否忽略
}

// 完整标识符表
table FullId {
  pkgId:int32;  // 声明所属的包
  decl:string;  // 其他包中被引用节点的导出ID
  index:uint32; // 同一包中被引用声明的索引
}

// 约束表
table Constraint {
  begin:Position;   // 开始位置
  end:Position;     // 结束位置
  type:uint32;      // 对应类型参数的类型
  uppers:[uint32];  // 上界
}

// 泛型表
table Generic{
  typeParameters:[uint32]; // 泛型参数声明
  constraints:[Constraint]; // 约束列表
}

// 函数参数列表表
table FuncParamList {
  params:[uint32];   // 参数列表
  desugars:[uint32]; // 去语法糖后的参数
}

// 函数体表
table FuncBody {
  paramLists:[FuncParamList]; // 参数列表集合
  retType:uint32;             // 返回类型
  body:uint32;                // 函数体表达式索引
  always:bool;                // 是否总是执行
  captureKind:uint8;          // 捕获类型
}

// 声明哈希结构
struct DeclHash {
  instVar:uint64;  // 实例变量哈希
  virt:uint64;     // 虚拟哈希
  sig:uint64;      // 签名哈希
  srcUse:uint64;   // 源码使用哈希
  bodyHash:uint64; // 函数体哈希
}

// 常量值联合体
union ConstValue {
  Int8Value,    // 8位有符号整数值
  UInt8Value,   // 8位无符号整数值
  Int16Value,   // 16位有符号整数值
  UInt16Value,  // 16位无符号整数值
  Int32Value,   // 32位有符号整数值
  UInt32Value,  // 32位无符号整数值
  Int64Value,   // 64位有符号整数值
  UInt64Value,  // 64位无符号整数值
  Float32Value, // 32位浮点值
  Float64Value, // 64位浮点值
  ArrayValue,   // 数组值
  StringValue:string,              // 字符串值
  CompositeValue:CompositeValueIndex, // 复合值
}
table Int8Value { val:int8; }
table UInt8Value { val:uint8; }
table Int16Value { val:int16; } // 也表示 Float16
table UInt16Value { val:uint16; }
table Int32Value { val:int32; }
table UInt32Value { val:uint32; }
table Int64Value { val:int64; }
table UInt64Value { val:uint64; }
table Float32Value { val:float32; }
table Float64Value { val:float64; }
table ArrayValue { val:[ConstValue]; }
table CompositeValueIndex { idx:uint32; }
// 成员值表
table MemberValue {
  field:string;      // 字段名
  type:uint32;       // 字段类型
  value:ConstValue;  // 字段值
}
// 复合值表 - 表示类、结构体、元组、枚举
table CompositeValue {
  type:uint32;           // 类型
  fields:[MemberValue];  // 成员字段
}

// 自动微分信息表
table AutoDiffInfo {
  isDiff:bool;         // 是否可微分
  isAdj:bool;          // 是否伴随
  primal:string;       // 原始函数
  excepts:[string];    // 排除项
  includes:[string];   // 包含项
  stage:uint64;        // 阶段
}
// 类信息表
table ClassInfo {
  inheritedTypes:[uint32]; // 继承的类型
  body:[uint32];           // 类体
  adInfo:AutoDiffInfo;     // 自动微分信息
  isAnno:bool = false;     // 指示当前类是否为自定义注解
  annoTargets:uint8;       // 自定义注解的目标（如果是注解类）
  runtimeVisible:bool;     // 运行时可见性
  annoTargets2:uint8;      // 注解目标扩展
}
// 接口信息表
table InterfaceInfo {
  inheritedTypes:[uint32]; // 继承的类型
  body:[uint32];           // 接口体
}
// 结构体信息表
table StructInfo {
  inheritedTypes:[uint32]; // 继承的类型
  body:[uint32];           // 结构体体
  adInfo:AutoDiffInfo;     // 自动微分信息
}
// 枚举信息表
table EnumInfo {
  inheritedTypes:[uint32]; // 继承的类型
  body:[uint32];           // 枚举体
  adInfo:AutoDiffInfo;     // 自动微分信息
  hasArguments:bool;       // 是否有参数
  nonExhaustive:bool;      // 是否非穷尽
  ellipsisPos:Position;    // 省略号位置
}
// 扩展信息表
table ExtendInfo {
  inheritedTypes:[uint32]; // 继承的类型
  body:[uint32];           // 扩展体
}
// 变量信息表
table VarInfo {
  isVar:bool;           // 是否可变
  isConst:bool;         // 是否常量
  isMemberParam:bool;   // 是否成员参数
  initializer:uint32;   // 初始化表达式索引
  value:ConstValue;     // 如果是常量则有值
}
// 带模式的变量信息表
table VarWithPatternInfo {
  isVar:bool;                 // 是否可变
  isConst:bool;               // 是否常量
  irrefutablePattern:Pattern; // 不可反驳模式（仅存在于表达式子节点）
  initializer:uint32;         // 初始化表达式索引
}
// 溢出策略枚举
enum OverflowPolicy : uint8 {
  NA,         // 无
  Checked,    // 检查
  Wrapping,   // 环绕
  Throwing,   // 抛出异常
  Saturating, // 饱和
}
// 操作符类型枚举
enum OperatorKind : uint8 {
  NA,
  // 可重载操作符
  Index, // []    索引
  Call,  // ()    调用
  Not,   // !     非
  Power,     // **    幂运算
  Multiply,  // *     乘法
  Divide,    // /     除法
  Remainder, // %     取余
  Add,       // +     加法
  Subtract,  // -     减法
  BitLeftShift,  // <<    左移
  BitRightShift, // >>    右移
  LT,       // <     小于
  LE,       // <=    小于等于
  GT,       // >     大于
  GE,       // >=    大于等于
  Equal,    // ==    相等
  NotEqual, // !=    不等
  BitAnd,   // &     按位与
  BitXor,   // ^     按位异或
  BitOr,    // |     按位或

  // 其他操作符
  PostInc,     // ++    后缀递增
  PostDec,     // --    后缀递减
  Is,          // is    类型检查
  As,          // as    类型转换
  LogicAnd,    // &&    逻辑与
  LogicOr,     // ||    逻辑或
  Coalescing,  // ??    空值合并
  Pipeline,    // |>    管道
  Composition, // ~>    组合
  Assign,      // =     赋值
  PowerAssign,      // **=   幂赋值
  MultiplyAssign,   // *=    乘法赋值
  DivideAssign,     // /=    除法赋值
  RemainderAssign,  // %=    取余赋值
  AddAssign,        // +=    加法赋值
  SubtractAssign,   // -=    减法赋值
  LeftShiftAssign,  // <<=   左移赋值
  RightShiftAssign, // >>=   右移赋值
  BitAndAssign,     // &=    按位与赋值
  BitXorAssign,     // ^=    按位异或赋值
  BitOrAssign,      // |=    按位或赋值
  LogicAndAssign,   // &&=   逻辑与赋值
  LogicOrAssign,    // ||=   逻辑或赋值
}
// 函数信息表
table FuncInfo {
  funcBody:FuncBody;           // 函数体
  overflowPolicy:OverflowPolicy; // 溢出策略
  op:OperatorKind = NA;        // 操作符类型
  adInfo:AutoDiffInfo;         // 自动微分信息
  isConst:bool;                // 是否常量函数
  isInline:bool;               // 是否内联函数
  isFastNative:bool;           // 是否快速原生函数
}
// 参数信息表
table ParamInfo {
  isNamedParam:bool;   // 是否命名参数
  isMemberParam:bool;  // 是否成员参数
  defaultVal:uint32;   // 默认值表达式索引
}
// 属性信息表
table PropInfo {
  isConst:bool;       // 是否常量
  isMutable:bool;     // 是否可变
  setters:[uint32];   // 设置器列表
  getters:[uint32];   // 获取器列表
}
// 内置类型枚举
enum BuiltInType : uint8 {
  Array,     // 数组
  VArray,    // 可变数组
  CPointer,  // C指针
  CString,   // C字符串
  CFunc,     // C函数
}
// 内置类型信息表
table BuiltInInfo {
  builtInType:BuiltInType; // 内置类型
}
// 类型别名信息表
table AliasInfo {
  aliasedTy:uint32; // 被别名化的语义类型索引
}
// 声明信息联合体
union DeclInfo {
  ClassInfo,           // 类信息
  InterfaceInfo,       // 接口信息
  StructInfo,          // 结构体信息
  EnumInfo,            // 枚举信息
  ExtendInfo,          // 扩展信息
  PropInfo,            // 属性信息
  VarInfo,             // 变量信息
  VarWithPatternInfo,  // 带模式的变量信息
  ParamInfo,           // 参数信息
  FuncInfo,            // 函数信息
  BuiltInInfo,         // 内置类型信息
  AliasInfo,           // 类型别名信息
}

table Decl {
  kind:DeclKind = InvalidDecl;  // 声明类型，默认为无效声明
  isTopLevel:bool = false; // whether the decl is toplevel  // 是否为顶层声明
  fullPkgName:string;  // 完整包名，包含命名空间路径
  genericDecl:FullId;  // 泛型声明的完整标识符
  generic:Generic;  // 泛型参数信息
  begin:Position;  // 声明在源代码中的起始位置
  end:Position;  // 声明在源代码中的结束位置
  identifier:string;  // 声明的标识符名称
  identifierPos:Position;  // 标识符在源代码中的位置
  attributes:[uint64];  // 声明的属性集合（位掩码）
  annotations:[Anno];  // 声明的注解列表

  // Semantic & CodeGen info
  type: uint32;  // 声明的类型索引，用于语义分析
  mangledName: string; // mangledName for CodeGen  // 用于代码生成的混淆名称
  exportId: string;    // exportId for import  // 用于导入导出的唯一标识符

  // info used in ast diff
  mangledBeforeSema:string;  // 语义分析前的混淆名称，用于AST差异比较
  hash:DeclHash;  // 声明的哈希值，用于增量编译
  // Specific information for each specific kind of declaration
  info:DeclInfo;  // 特定声明类型的详细信息联合体
}


// 注解类型枚举
enum AnnoKind : uint16 {
  Deprecated,        // 已弃用
  TestRegistration,  // 测试注册  
  Frozen,            // 冻结
  Custom             // 自定义
}

// 当前注解表示是 @Deprecated 需求和其他注解潜在通用化之间的平衡
// 注解表（简称 Anno，以避免与 CHIRFormat.fbs 中的 Annotation 冲突）
table Anno {
  kind:AnnoKind;      // 注解类型
  identifier:string;  // 标识符
  args:[AnnoArg];     // 参数列表
}

// 注解参数表
table AnnoArg {
  name:string;  // 参数名
  expr:uint32;  // 表达式索引（LitConstExpr）
}

enum ExprKind : uint16 {
  InvalidExpr,
  WildcardExpr,
  PrimitiveTypeExpr,
  ReturnExpr,
  JumpExpr,
  MemberAccess,
  RefExpr,
  CallExpr,
  UnaryExpr,
  IncOrDecExpr,
  LitConstExpr,
  BinaryExpr,
  SubscriptExpr,
  AssignExpr,
  ArrayExpr,
  PointerExpr,
  TypeConvExpr,
  ThrowExpr,
  SpawnExpr,
  ArrayLit,
  TupleLit,
  MatchExpr,
  LetPatternDestructor,
  IfExpr,
  TryExpr,
  WhileExpr,
  DoWhileExpr,
  LambdaExpr,
  Block,
  MatchCase,
  MatchCaseOther,
  AdjointExpr,
  GradExpr,
  ValWithGradExpr,
  VJPExpr,
  ForInExpr,
  IfAvailableExpr,
}

enum CallKind : uint8 {
  NA,                    // 不适用
  CallDeclaredFunction,  // 调用声明的函数
  CallObjectCreation,    // 调用对象创建
  CallStructCreation,    // 调用结构体创建
  CallSuperFunction,     // 调用父类函数
  CallVariadicFunction,  // 调用变参函数
  CallFunctionPtr,       // 调用函数指针
  CallAnnotation,        // 调用注解
  CallBuiltinFunction,   // 调用内置函数
  CallIntrinsicFunction, // 调用内部函数
}

enum LitConstKind : uint8 {
  Integer,  // 整数
  RuneByte, // 字节
  Float,    // 浮点数
  Rune,     // 字符
  String,   // 字符串
  JString,  // J字符串
  Bool,     // 布尔值
  Unit,     // 单元值
}
enum StringKind : uint8 {
  Normal,       // 普通字符串
  JString,      // J字符串
  MultiLine,    // 多行字符串
  MultiLineRaw, // 多行原始字符串
}

enum ForInKind : uint8 {
  NA,       // 不适用
  Range,    // 范围
  String,   // 字符串
  Iterator, // 迭代器
}

union ExprInfo {
  CallInfo,                 // 调用信息
  UnaryInfo,                // 一元操作信息
  BinaryInfo,               // 二元操作信息
  IncOrDecInfo,             // 自增或自减信息
  LitConstInfo,             // 字面常量信息
  ReferenceInfo,            // 引用信息
  LambdaInfo,               // Lambda表达式信息
  AssignInfo,               // 赋值信息
  ArrayInfo,                // 数组信息
  JumpInfo,                 // 跳转信息
  FuncArgInfo,              // 函数参数信息
  SubscriptInfo,            // 下标信息
  MatchInfo,                // 匹配信息
  BlockInfo,                // 块信息
  TryInfo,                  // Try信息
  LetPatternDestructorInfo, // Let模式解构信息
  ForInInfo,                // For-In信息
  MatchCaseInfo,            // 匹配分支信息
  SpawnInfo,                // 协程创建信息
}
table CallInfo {
  hasSideEffect:bool;      // 是否有副作用
  callKind:CallKind = NA;  // 调用类型，默认为NA
}
table UnaryInfo {
  op:OperatorKind;  // 操作符类型
}
table BinaryInfo {
  op:OperatorKind;  // 操作符类型
}
table IncOrDecInfo {
  op:OperatorKind;  // 操作符类型（自增或自减）
}
table LitConstInfo {
  strValue:string;        // 字符串值
  constKind:LitConstKind; // 常量类型
  strKind:StringKind;     // 字符串类型
}
table ReferenceInfo {
  // For RefExpr/MemberAccess
  reference:string; // 引用名称，也用于LitConstExpr字符串值
  target:FullId;    // 目标标识符
  instTys:[uint32]; // 实例化类型索引向量
  matchedParentTy:uint32; // 用于实例化重排
}
table LambdaInfo {
  funcBody:FuncBody (required); // Lambda表达式的函数体
  supportMock:bool;            // 是否支持模拟
}
table AssignInfo {
  isCompound:bool;   // 是否为复合赋值
  op:OperatorKind;   // 操作符类型
}
table ArrayInfo {
  initFunc:FullId;    // 初始化函数
  isValueArray:bool;  // 是否为值数组
}
table JumpInfo {
  isBreak:bool;  // 是否为break语句（否则为continue）
}
table FuncArgInfo {
  withInout:bool;    // 是否带有inout修饰符
  isDefaultVal:bool; // 是否为默认值
}
table SubscriptInfo {
  isTupleAccess:bool; // 是否为元组访问
}
table MatchInfo {
  matchMode:bool; // 匹配模式
}
table BlockInfo {
  isExpr:[bool]; // 是否为表达式块
}
table TryInfo {
  resources:[FullId]; // 用于try-with-resource的资源
  patterns:[Pattern]; // 匹配模式列表
}
table LetPatternDestructorInfo {
  patterns:[Pattern]; // 解构模式列表
}
table ForInInfo {
  pattern:Pattern;           // 迭代变量模式
  forInKind:ForInKind = NA; // for-in类型
}
table MatchCaseInfo {
  patterns:[Pattern]; // 匹配分支模式列表
}
table SpawnInfo {
  future:FullId; // Future类型标识符
}

// 表达式表
table Expr {
  kind:ExprKind = InvalidExpr; // 表达式类型
  begin:Position;              // 开始位置
  end:Position;                // 结束位置
  mapExpr:uint32;              // 处理副作用的表达式索引
  operands:[uint32];           // 子表达式索引
  type:uint32;                 // 类型
  overflowPolicy:OverflowPolicy; // 溢出策略
  info:ExprInfo;               // 表达式信息
}

// 模式类型枚举
enum PatternKind:int8 {
  InvalidPattern,    // 无效模式
  ConstPattern,      // 常量模式
  WildcardPattern,   // 通配符模式
  VarPattern,        // 变量模式
  TuplePattern,      // 元组模式
  TypePattern,       // 类型模式
  EnumPattern,       // 枚举模式
  ExceptTypePattern, // 异常类型模式
}

// 模式表
table Pattern {
  kind:PatternKind = InvalidPattern; // 模式类型
  begin:Position;                    // 开始位置
  end:Position;                      // 结束位置
  patterns:[Pattern];                // 子模式列表
  types:[uint32];                    // 语义类型索引
  exprs:[uint32];                    // 表达式索引
  values:[ConstValue];               // 常量值列表
  matchBeforeRuntime:bool;           // 运行时前匹配
  needRuntimeTypeCheck:bool;         // 需要运行时类型检查
}

// 为了兼容性，任何新的类型种类必须只能在最后添加
// 类型种类枚举
enum TypeKind : uint16 {
  Invalid, // 无效类型

  // 原始类型
  Unit, // 单元类型
  // 整数类型
  Int8,     // 8位整数
  Int16,    // 16位整数
  Int32,    // 32位整数
  Int64,    // 64位整数
  IntNative, // 原生整数

  // 无符号整数类型
  UInt8,      // 8位无符号整数
  UInt16,     // 16位无符号整数
  UInt32,     // 32位无符号整数
  UInt64,     // 64位无符号整数
  UIntNative, // 原生无符号整数
  // 浮点类型
  Float16, // 16位浮点数
  Float32, // 32位浮点数
  Float64, // 64位浮点数

  Rune,    // 字符类型
  Nothing, // 空类型
  Bool,    // 布尔类型

  // 复合类型
  Tuple,  // 元组类型
  Enum,   // 枚举类型
  Func,   // 函数类型
  Struct, // 结构体类型

  // 引用类型
  Array,     // 数组类型
  VArray,    // 可变数组类型
  CPointer,  // C指针类型
  CString,   // C字符串类型
  Class,     // 类类型
  Interface, // 接口类型

  Type,    // 类型别名
  Generic, // 泛型
}

// 语义类型信息联合体
union SemaTyInfo {
  FuncTyInfo,      // 函数类型信息
  CompositeTyInfo, // 复合类型信息
  GenericTyInfo,   // 泛型类型信息
  ArrayTyInfo,     // 数组类型信息
}
// 函数类型信息表
table FuncTyInfo {
  retType:uint32;         // 函数返回类型
  isC:bool;               // 是否C函数或@C函数类型
  hasVariableLenArg:bool; // 是否有变长参数
}
// 复合类型信息表
table CompositeTyInfo {
  declPtr:FullId;         // 声明指针
  isThisTy:bool=false;    // 是否this类型
}
// 泛型类型信息表
table GenericTyInfo {
  declPtr:FullId;       // 声明指针
  upperBounds:[uint32]; // 上界列表
}
// 数组类型信息表
table ArrayTyInfo {
  dimsOrSize:int64; // 维度或大小
}

// 语义类型表
table SemaTy {
  kind:TypeKind=Unit;     // 类型种类，默认为Unit
  // 类型参数，也用于函数类型的参数类型
  typeArgs:[uint32];      // 类型参数列表
  info:SemaTyInfo;        // 类型信息
}

// 访问修饰符枚举
enum AccessModifier : uint8 {
  Private,   // 私有
  Internal,  // 内部
  Protected, // 受保护
  Public,    // 公共
}

// 导入规范表
table ImportSpec {
  begin:Position;                     // 开始位置
  end:Position;                       // 结束位置
  prefixPaths:[string];               // 前缀路径
  identifier:string;                  // 标识符
  asIdentifier:string;                // 别名标识符
  reExport:AccessModifier = Private;  // 重新导出级别
}

// 导入列表表
table Imports {
  importSpecs:[ImportSpec]; // 导入规范列表
}

// 包类型枚举
enum PackageKind : uint8 {
  Normal,  // 普通包
  Macro,   // 宏包
  Foreign, // 外部语言包
  Mock,    // 支持模拟的包
}

// 访问级别枚举
enum AccessLevel : uint8 {
  Public,    // 公共
  Protected, // 受保护
  Internal,  // 内部
}

// CJO版本结构
struct CjoVersion {
  major_num:uint8; // 主版本号
  minor_num:uint8; // 次版本号
  patch_num:uint8; // 补丁版本号
}

// 所有语义类型、声明都保存在这里，并被其他节点索引
// 包表
table Package {
  version:string;              // cjc版本
  cjoVersion:CjoVersion;       // cjo格式版本
  fullPkgName:string;          // 完整包名
  pkgDepInfo:string;           // 包依赖信息
  imports:[string];            // 所有导入的包
  allFiles:[string];           // 包中的所有文件
  allFileImports:[Imports];    // 包中所有文件的导入
  allTypes:[SemaTy];           // 所有保存的语义类型
  allDecls:[Decl];             // 所有保存的声明
  allExprs:[Expr];             // 所有保存的表达式
  allValues:[CompositeValue];  // 所有保存的常量复合值
  kind:PackageKind = Normal;   // 包类型
  access:AccessLevel = Public; // 访问级别
  moduleName:string;           // 模块名
}

root_type Package;
