// 命名空间：宏消息格式定义
namespace MacroMsgFormat;

// 位置信息结构体：记录源码中某个位置的文件、行号和列号
struct Position {
  file_id: uint32;   // 文件唯一标识符
  line: int32;       // 行号
  column: int32;     // 列号
}

// Token（词法单元）表：表示源码中的一个词法单元
table Token {
  kind: uint8;           // Token 类型（枚举值）
  value: string;         // Token 的文本内容
  begin: Position;       // Token 起始位置
  end: Position;         // Token 结束位置
  delimiterNum: uint32 = 1;  // 分隔符数量，默认为 1
}

// 标识符信息表：记录标识符名称及其在源码中的位置
table IdInfo {
  name: string;    // 标识符名称
  pos: Position;   // 标识符位置
}

// 整型值结构体：封装一个 int64 整数
struct IntValue {
  val: int64;
}

// 布尔值结构体：封装一个布尔值
struct BoolValue {
  val: bool;
}

// Token 列表值表：封装一组 Token
table TokensValue {
  val: [Token];    // Token 数组
}

// 选项值联合体：可以是字符串、整数、布尔值或 Token 列表
union OptionValue {
  sValue: string,       // 字符串类型的值
  iValue: IntValue,     // 整型值
  bValue: BoolValue,    // 布尔型值
  tValue: TokensValue   // Token 列表类型的值
}

// 条目信息表：键值对，用于传递宏的配置项或输出项
table ItemInfo {
  key: string;          // 条目的键名
  value: OptionValue;   // 条目对应的值（联合类型）
}

// 子消息表：表示宏调用中的一个子结构消息
table ChildMsg {
  childName: string;    // 子消息名称
  items: [ItemInfo];    // 子消息包含的条目列表
}

// 动态库定义表：记录动态库的搜索路径列表
table DefLib {
  paths: [string];      // 动态库路径数组
}

// 诊断信息表：记录宏处理过程中产生的诊断（错误/警告）
table Diagnostic {
  diagSeverity: int32;     // 诊断级别（如：错误、警告、提示）
  begin: Position;         // 诊断范围起始位置
  end: Position;           // 诊断范围结束位置
  errorMessage: string;    // 错误消息正文
  mainHint: string;        // 主要提示信息
}

// 宏调用表：描述一次完整的宏调用信息
table MacroCall {
  id: IdInfo;               // 宏的标识符信息
  hasAttrs: bool;           // 是否携带属性参数
  args: [Token];            // 宏调用的普通参数（Token 列表）
  attrs: [Token];           // 宏调用的属性参数（Token 列表）
  parentNames: [string];    // 父级宏名称列表（用于嵌套宏场景）
  childMsges: [ChildMsg];   // 子消息列表
  methodName: string;       // 宏所在的方法名
  packageName: string;      // 宏所在的包名
  libPath: string;          // 宏实现所在的库路径
  begin: Position;          // 宏调用起始位置
  end: Position;            // 宏调用结束位置
}

// 宏执行结果表：描述宏处理完成后的返回结果
table MacroResult {
  id: IdInfo;                  // 对应宏的标识符信息
  status: uint8;               // 执行状态码（如：成功、失败等）
  tks: [Token];                // 宏展开后输出的 Token 列表
  items: [ItemInfo];           // 宏返回的条目信息列表
  assertParents: [string];     // 断言的父级宏名称列表
  diags: [Diagnostic];         // 诊断信息列表（错误/警告）
}

// 多宏调用表：批量封装多个宏调用请求
table MultiMacroCalls {
  calls: [MacroCall];    // 宏调用数组
}

// 退出任务结构体：用于通知宏处理器退出
struct ExitTask {
  flag: bool;    // 退出标志，true 表示请求退出
}

// 消息内容联合体：表示一条宏通信消息的具体内容类型
union MsgContent {
  defLib: DefLib,                // 动态库定义消息
  multiCalls: MultiMacroCalls,   // 多个宏调用消息
  macroResult: MacroResult,      // 宏执行结果消息
  exitTask: ExitTask             // 退出任务消息
}

// 宏消息表：宏处理器与编译器之间通信的顶层消息结构
table MacroMsg {
  content: MsgContent;    // 消息内容（联合类型）
}

// 指定 MacroMsg 为 FlatBuffers 序列化的根类型
root_type MacroMsg;