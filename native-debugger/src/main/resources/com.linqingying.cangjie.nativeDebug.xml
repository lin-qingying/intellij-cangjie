<idea-plugin package="cn.cangnova.cangjie.debugger">

    <module value="cn.cangnova.cangjie.nativeDebug"/>
    <dependencies>

        <plugin id="com.intellij.modules.cidr.debugger"/>
        <plugin id="com.intellij.nativeDebug"/>

    </dependencies>
    <extensionPoints>
        <extensionPoint qualifiedName="cn.cangnova.cangjie.debugger.driverConfigurationProvider"
                        interface="cn.cangnova.cangjie.debugger.CjDebuggerDriverConfigurationProvider"
                        dynamic="true"/>

    </extensionPoints>
    <extensions defaultExtensionNs="cidr.debugger">
        <editorsExtension language="CangJie" implementationClass="cn.cangnova.cangjie.debugger.lang.CjDebuggerEditorsExtension"/>

        <languageSupport language="CangJie"
                         implementationClass="cn.cangnova.cangjie.debugger.lang.CjDebuggerLanguageSupport"/>
        <lineBreakpointFileTypesProvider
                implementation="cn.cangnova.cangjie.debugger.CjLineBreakpointFileTypesProvider"/>

        <debugProcessConfigurator
                implementation="cn.cangnova.cangjie.debugger.runconfig.CjDebugProcessConfigurator"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <xdebugger.settings implementation="cn.cangnova.cangjie.debugger.settings.CjDebuggerSettings"/>


        <programRunner id="CjDebugRunner"
                       implementation="cn.cangnova.cangjie.debugger.runconfig.CjDebugRunner"/>

        <programRunner id="CjDebugRunnerLegacy"
                       implementation="cn.cangnova.cangjie.debugger.runconfig.legacy.CjDebugRunnerLegacy"/>
        <registryKey key="cn.cangnova.cangjie.debugger.gdb.setup.v2"
                     defaultValue="false"
                     description="Enables new way how GDB is set up for CangJie"/>

        <registryKey key="cn.cangnova.cangjie.debugger.gdb.setup.v2"
                     defaultValue="false"
                     description="Enables new way how GDB is set up for CangJie"/>

        <registryKey key="cn.cangnova.cangjie.debugger.lldb.cangjie.msvc" defaultValue="true"
                     restartRequired="false"
                     description="Enable CangJie MSVC support in LLDB (Windows-only)"/>

    </extensions>

    <extensions defaultExtensionNs="cn.cangnova.cangjie">
        <debugger.driverConfigurationProvider
                id="CjDefaultDebuggerDriverConfigurationProvider"
                implementation="cn.cangnova.cangjie.debugger.CjDefaultDebuggerDriverConfigurationProvider"
                order="last"/>
    </extensions>
</idea-plugin>
