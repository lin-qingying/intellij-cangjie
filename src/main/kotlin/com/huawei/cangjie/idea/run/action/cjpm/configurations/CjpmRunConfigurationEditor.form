<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.huawei.cangjie.idea.run.action.cjpm.configurations.CjpmRunConfigurationEditor">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="26" y="127" width="664" height="299"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="7d9df" class="com.intellij.openapi.ui.LabeledComponent" binding="moudle">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="com.intellij.openapi.ui.TextFieldWithBrowseButton"/>
          <enabled value="true"/>
          <labelLocation value="West"/>
          <text value="moudle.json "/>
        </properties>
      </component>
      <component id="ea082" class="com.intellij.openapi.ui.LabeledComponent" binding="command">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="com.intellij.openapi.ui.ComboBox"/>
          <enabled value="true"/>
          <font style="1"/>
          <labelInsets top="0" left="0" bottom="0" right="48"/>
          <labelLocation value="West"/>
          <text resource-bundle="messages/CangJieUiBundle" key="action.run.cjpm.configuration.command.title"/>
          <toolTipText value=""/>
        </properties>
      </component>
      <component id="d1d85" class="com.intellij.openapi.ui.LabeledComponent" binding="args">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="1" use-parent-layout="false"/>
        </constraints>
        <properties>
          <componentClass value="javax.swing.JTextField"/>
          <enabled value="true"/>
          <labelInsets top="0" left="0" bottom="0" right="48"/>
          <labelLocation value="West"/>
          <text resource-bundle="messages/CangJieUiBundle" key="action.run.cjpm.configuration.args.title"/>
        </properties>
      </component>
      <vspacer id="fe722">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="10"/>
          </grid>
        </constraints>
      </vspacer>
    </children>
  </grid>
</form>
