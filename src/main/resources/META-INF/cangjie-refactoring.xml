<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">
        <lang.refactoringSupport
                language="CangJie"
                implementationClass="cn.cangnova.cangjie.ide.refactoring.CangJieRefactoringSupportProvider"/>
        <projectService serviceInterface="cn.cangnova.cangjie.ide.refactoring.introduce.CangJieIntroduceVariableService"
                        serviceImplementation="cn.cangnova.cangjie.ide.refactoring.introduce.CangJieIntroduceVariableService$Default"
        />


        <applicationService serviceImplementation="cn.cangnova.cangjie.ide.refactoring.CangJieCommonRefactoringSettingsImpl"
                            serviceInterface="cn.cangnova.cangjie.ide.refactoring.CangJieCommonRefactoringSettings"/>

        <applicationService serviceImplementation="cn.cangnova.cangjie.ide.refactoring.CangJieRefactoringSettings"/>

    </extensions>
</idea-plugin>