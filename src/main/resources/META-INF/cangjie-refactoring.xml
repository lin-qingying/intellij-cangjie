<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">
        <lang.refactoringSupport
                language="CangJie"
                implementationClass="org.cangnova.cangjie.ide.refactoring.CangJieRefactoringSupportProvider"/>
        <projectService serviceInterface="org.cangnova.cangjie.ide.refactoring.introduce.CangJieIntroduceVariableService"
                        serviceImplementation="org.cangnova.cangjie.ide.refactoring.introduce.CangJieIntroduceVariableService$Default"
        />


        <applicationService serviceImplementation="org.cangnova.cangjie.ide.refactoring.CangJieCommonRefactoringSettingsImpl"
                            serviceInterface="org.cangnova.cangjie.ide.refactoring.CangJieCommonRefactoringSettings"/>

        <applicationService serviceImplementation="org.cangnova.cangjie.ide.refactoring.CangJieRefactoringSettings"/>

    </extensions>
</idea-plugin>