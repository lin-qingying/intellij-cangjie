<idea-plugin>

    <extensionPoints>
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.ide.completionInformationProvider"
                interface="cn.cangnova.cangjie.ide.completion.CompletionInformationProvider"
                dynamic="true"/>
        <extensionPoint qualifiedName="cn.cangnova.cangjie.ide.completion.turboComplete.smartPipelineRunner"
                        interface="cn.cangnova.cangjie.ide.completion.turboComplete.SmartPipelineRunner"
                        dynamic="true"/>

    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">

        <applicationService
                serviceInterface="cn.cangnova.cangjie.ide.completion.CompletionDummyIdentifierProviderService"
                serviceImplementation="cn.cangnova.cangjie.ide.completion.CangJieCompletionDummyIdentifierProviderService"/>

        <registryKey
                key="cangjie.auto.completion.prefer.vararg.to.noargs"
                description="For functions show vararg variant before no argruments variant"
                defaultValue="true"
                restartRequired="false"/>
        <applicationService
                serviceInterface="cn.cangnova.cangjie.ide.completion.handlers.SmartCompletionTailOffsetProvider"
                serviceImplementation="cn.cangnova.cangjie.ide.completion.handlers.SmartCompletionTailOffsetProviderImpl"/>

        <registryKey
                key="cangjie.auto.completion.insert.constructor.parenthesis"
                description="Insert constructor parenthesis on class autocompletion"
                defaultValue="false"
                restartRequired="false"/>
        <!--代码补全-->
        <completion.contributor
                language="CangJie"
                id="CangJieCompletionContributor"
                order="first, after liveTemplates"
                implementationClass="cn.cangnova.cangjie.ide.completion.CangJieCompletionContributor"/>
        <completion.contributor
                language="CangJie"
                implementationClass="cn.cangnova.cangjie.ide.completion.CDocCompletionContributor"/>
    </extensions>
</idea-plugin>
