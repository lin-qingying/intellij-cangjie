<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">

        <stubElementTypeHolder externalIdPrefix="cangjie."
                               class="org.cangnova.cangjie.psi.stubs.elements.CjStubElementTypes"/>
        <!--         Stub索引服务 -->
        <applicationService
                serviceInterface="org.cangnova.cangjie.psi.stubs.elements.StubIndexService"
                serviceImplementation="org.cangnova.cangjie.ide.stubindex.IdeStubIndexService"/>


        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelFunctionByPackageIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelTypeAliasByPackageIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelVariableByPackageIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelFunctionFqnNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieMainFunctionFqnNameIndex"/>

        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieMacroDeclarationByPackageIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieMacroDeclarationFqnNameIndex"/>

        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieMacroDeclarationShortNameIndex"/>


        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieFunctionShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieProbablyNothingFunctionShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJiePrimeSymbolNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieOverridableInternalMembersShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieExactPackagesIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieClassShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieEnumEntryShortNameIndex"/>

        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieSuperClassIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelTypeAliasFqNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelPropertyFqnNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelPropertyByPackageIndex"/>

        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelVariableFqnNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelClassByPackageIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieFullClassNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJiePropertyShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieVariableShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTopLevelExtensionsByReceiverTypeIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieProbablyNothingPropertyShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieVariableNothingVariableShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTypeAliasShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieTypeAliasByExpansionShortNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieImportFqNameForPackageNameIndex"/>
        <stubIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieExtendClassNameIndex"/>


        <fileBasedIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJiePackageSourcesMemberNamesIndex"/>

        <fileBasedIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJiePartialPackageNamesIndex"/>
        <fileBasedIndex implementation="org.cangnova.cangjie.ide.stubindex.CangJieShortClassNameFileIndex"/>


        <notificationGroup
                id="Recover CangJie Indices"
                displayType="STICKY_BALLOON"
                bundle="messages.CangJieAnalysisBundle"
                key="cangjie.repair.indices.group.name"
        />

        <registryKey key="cangjie.indices.short.names.filtering.enabled" defaultValue="true"
                     description="Filter irrelevant CangJie FQNames by short name index"
                     restartRequired="true"/>

        <registryKey key="cangjie.indices.nested.access.enabled"
                     defaultValue="false"
                     description="Allows nested indices access"/>
        <registryKey key="cangjie.indices.timing.threshold.single"
                     defaultValue="2500"
                     description="Time threshold in ms to report slow index single get access"/>
        <registryKey key="cangjie.indices.timing.threshold.batch"
                     defaultValue="5000"
                     description="Time threshold in ms to report slow index batch (processAll-like) access"/>
        <registryKey key="cangjie.indices.timing.enabled"
                     defaultValue="false"
                     description="Allows indices access time tracking"/>


    </extensions>

    <extensionPoints>
        <extensionPoint qualifiedName="org.cangnova.cangjie.ide.search.classInheritorsSearch"
                        interface="com.intellij.util.QueryExecutor" dynamic="true"/>
        <extensionPoint qualifiedName="org.cangnova.cangjie.ide.search.directClassInheritorsSearch"
                        interface="com.intellij.util.QueryExecutor" dynamic="true"/>

    </extensionPoints>

    <projectListeners>
        <!--        监听索引损坏-->
        <!--        <listener class="org.cangnova.cangjie.ide.stubindex.resolve.CangJieRepairIdeAfterCorruptionNotification"-->
        <!--                  topic="org.cangnova.cangjie.ide.stubindex.resolve.CangJieCorruptedIndexListener"-->
        <!--                  activeInHeadlessMode="false"-->
        <!--                  activeInTestMode="false"/>-->


    </projectListeners>
</idea-plugin>
