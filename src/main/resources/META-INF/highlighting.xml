<idea-plugin>



    <extensions defaultExtensionNs="com.intellij">
        <highlightVisitor implementation="com.huawei.cangjie.idea.highlighter.CangJieHighlightVisitor"/>
        <registryKey key="cangjie.highlighting.suspended.timeout"
                     description="Timeout (in seconds) when highlighting is temporarily turned off in case of unexpected errors."
                     defaultValue="10"
                     restartRequired="true"/>



        <projectService
                serviceInterface="com.huawei.cangjie.idea.base.projectStructure.RootKindMatcher"
                serviceImplementation="com.huawei.cangjie.idea.base.analysis.RootKindMatcherImpl"/>
    </extensions>
</idea-plugin>