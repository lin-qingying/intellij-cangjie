<idea-plugin>

    <extensionPoints>
        <extensionPoint
                qualifiedName="com.linqingying.cangjie.highlighterExtension"
                interface="com.linqingying.cangjie.highlighter.CangJieHighlightingVisitorExtension"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="CangJie"
                                        implementationClass="com.linqingying.cangjie.ide.lineMarkers.CangJieLineMarkerProvider"/>

        <additionalTextAttributes scheme="Default" file="colorScheme/Default_CangJie.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorScheme/Darcula_CangJie.xml"/>
        <highlightVisitor implementation="com.linqingying.cangjie.highlighter.CangJieHighlightVisitor"/>
        <registryKey key="cangjie.highlighting.suspended.timeout"
                     description="Timeout (in seconds) when highlighting is temporarily turned off in case of unexpected errors."
                     defaultValue="10"
                     restartRequired="true"/>

        <registryKey key="cangjie.highlighting.suppress.deprecated"
                     description="Suppress cangjie.Deprecated warning"
                     defaultValue="false"/>
        <projectService
                serviceInterface="com.linqingying.cangjie.highlighter.CangJieQuickFixProvider"
                serviceImplementation="com.linqingying.cangjie.ide.codeinsight.CangJieQuickFixProviderImpl"/>
        <applicationService
                serviceInterface="com.linqingying.cangjie.psi.CangJieDeclarationNavigationPolicy"
                serviceImplementation="com.linqingying.cangjie.psi.CangJieDeclarationNavigationPolicyImpl"/>

        <registryKey
                key="cangjie.resolve.force.full.resolve.on.highlighting"
                description="Force to perform full resolve on highlighting"
                defaultValue="true"
                restartRequired="false"/>
        <projectService
                serviceInterface="com.linqingying.cangjie.ide.base.projectStructure.RootKindMatcher"
                serviceImplementation="com.linqingying.cangjie.ide.base.analysis.RootKindMatcherImpl"/>
    </extensions>
</idea-plugin>
