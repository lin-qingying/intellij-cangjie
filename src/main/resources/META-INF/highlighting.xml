<idea-plugin>

    <extensionPoints>
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.highlighterExtension"
                interface="cn.cangnova.cangjie.highlighter.CangJieHighlightingVisitorExtension"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="CangJie"
                                        implementationClass="cn.cangnova.cangjie.ide.lineMarkers.CangJieLineMarkerProvider"/>
<!--    <highlightingPassFactory implementation="cn.cangnova.cangjie.highlighter.DebugInfoHighlightingPass$Registrar"/>-->


        <additionalTextAttributes scheme="Default" file="colorScheme/Default_CangJie.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorScheme/Darcula_CangJie.xml"/>
        <highlightVisitor implementation="cn.cangnova.cangjie.highlighter.CangJieHighlightVisitor"/>
        <registryKey key="cangjie.highlighting.suspended.timeout"
                     description="Timeout (in seconds) when highlighting is temporarily turned off in case of unexpected errors."
                     defaultValue="10"
                     restartRequired="true"/>

        <registryKey key="cangjie.highlighting.suppress.deprecated"
                     description="Suppress cangjie.Deprecated warning"
                     defaultValue="false"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.highlighter.CangJieQuickFixProvider"
                serviceImplementation="cn.cangnova.cangjie.ide.codeinsight.CangJieQuickFixProviderImpl"/>
        <applicationService
                serviceInterface="cn.cangnova.cangjie.psi.CangJieDeclarationNavigationPolicy"
                serviceImplementation="cn.cangnova.cangjie.psi.CangJieDeclarationNavigationPolicyImpl"/>

        <registryKey
                key="cangjie.resolve.force.full.resolve.on.highlighting"
                description="Force to perform full resolve on highlighting"
                defaultValue="true"
                restartRequired="false"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.ide.base.projectStructure.RootKindMatcher"
                serviceImplementation="cn.cangnova.cangjie.ide.base.analysis.RootKindMatcherImpl"/>
    </extensions>
</idea-plugin>
