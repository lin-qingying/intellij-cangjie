<idea-plugin>

    <extensionPoints>
        <extensionPoint
                qualifiedName="com.huawei.cangjie.highlighterExtension"
                interface="com.huawei.cangjie.ide.highlighter.CangJieHighlightingVisitorExtension"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <highlightVisitor implementation="com.huawei.cangjie.ide.highlighter.CangJieHighlightVisitor"/>
        <registryKey key="cangjie.highlighting.suspended.timeout"
                     description="Timeout (in seconds) when highlighting is temporarily turned off in case of unexpected errors."
                     defaultValue="10"
                     restartRequired="true"/>

        <registryKey key="cangjie.highlighting.suppress.deprecated"
                     description="Suppress cangjie.Deprecated warning"
                     defaultValue="false"/>
        <projectService
                serviceInterface="com.huawei.cangjie.ide.highlighter.CangJieQuickFixProvider"
                serviceImplementation="com.huawei.cangjie.ide.codeinsight.CangJieQuickFixProviderImpl"/>
        <applicationService
                serviceInterface="com.huawei.cangjie.psi.CangJieDeclarationNavigationPolicy"
                serviceImplementation="com.huawei.cangjie.psi.CangJieDeclarationNavigationPolicyImpl"/>

        <registryKey
                key="cangjie.resolve.force.full.resolve.on.highlighting"
                description="Force to perform full resolve on highlighting"
                defaultValue="true"
                restartRequired="false"/>
        <projectService
                serviceInterface="com.huawei.cangjie.ide.base.projectStructure.RootKindMatcher"
                serviceImplementation="com.huawei.cangjie.ide.base.analysis.RootKindMatcherImpl"/>
    </extensions>
</idea-plugin>
