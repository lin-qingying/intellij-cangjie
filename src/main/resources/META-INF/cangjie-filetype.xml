<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">

        <fileType name="cangjie_builtins" fieldName="INSTANCE" extensions="cangjie_builtins"
                  implementationClass="cn.cangnova.cangjie.lang.declarations.CangJieBuiltInFileType"/>


        <fileType.fileViewProviderFactory filetype="cangjie_builtins" implementationClass="cn.cangnova.cangjie.metadata.ClassFileViewProviderFactory"/>
        <filetype.decompiler filetype="cangjie_builtins" implementationClass="cn.cangnova.cangjie.psi.compiled.ClassFileDecompiler"/>

<!--        <fileType name="cangjie_declarations" fieldName="INSTANCE" extensions="cangjie_declarations"-->
<!--                  implementationClass="cn.cangnova.cangjie.lang.declarations.CangJieDeclarationsFileType"/>-->
<!--        -->

        <fileType name="cjd" fieldName="INSTANCE" extensions="cjd"
                  language="CangJie"
                  implementationClass="cn.cangnova.cangjie.lang.declarations.CangJieDeclarationsFileType"/>

    </extensions>

    <extensions defaultExtensionNs="cn.cangnova.cangjie">

        <classFileDecompiler implementation="cn.cangnova.cangjie.metadata.CangJieBuiltInDecompiler"/>

    </extensions>

</idea-plugin>
