<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <lang.formatter language="CangJie"
                        implementationClass="org.cangnova.cangjie.ide.formatter.CangJieFormattingModelBuilder"/>
        <!--        <formattingService id="LspFormattingService"-->
        <!--                           implementation="org.cangnova.cangjie.ide.formatter.CangJieFormattingService"/>-->

        <!--自动缩进-->
        <lineIndentProvider implementation="org.cangnova.cangjie.ide.formatter.CangJieLineIndentProvider"/>


        <!--        格式化预处理-->
        <!--        <preFormatProcessor implementation="org.cangnova.cangjie.ide.formatter.CangJiePreFormatProcessor"/>-->

        <!--后格式化处理器 尾随逗号-->
        <!--        <postFormatProcessor implementation="org.cangnova.cangjie.ide.formatter.TrailingCommaPostFormatProcessor"/>-->

        <!--代码样式设置-->
        <langCodeStyleSettingsProvider
                implementation="org.cangnova.cangjie.ide.formatter.CangJieLanguageCodeStyleSettingsProvider"/>

        <!--代码生成-->
        <codeStyleSettingsProvider
                implementation="org.cangnova.cangjie.ide.formatter.CangJieGenerationSettingsProvider"/>


        <!--符合标准风格的代码样式设置-->
        <predefinedCodeStyle implementation="org.cangnova.cangjie.ide.formatter.CangJieStyleGuideCodeStyle"/>


        <registryKey
                key="cangjie.formatter.allowTrailingCommaOnCallSite"
                description="Allow a trailing comma on call-site"
                defaultValue="false"
                restartRequired="false"/>
    </extensions>
</idea-plugin>
