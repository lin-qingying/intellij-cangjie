<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">

        <stubElementTypeHolder externalIdPrefix="cangjie."
                               class="com.huawei.cangjie.psi.stubs.elements.CjStubElementTypes"/>

        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelFunctionByPackageIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelTypeAliasByPackageIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelVariableByPackageIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelFunctionFqnNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieMainFunctionFqnNameIndex"/>

        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieFunctionShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieProbablyNothingFunctionShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJiePrimeSymbolNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieOverridableInternalMembersShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieExactPackagesIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieClassShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieSuperClassIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelTypeAliasFqNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelPropertyFqnNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelVariableFqnNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTopLevelClassByPackageIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieFullClassNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJiePropertyShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieVariableShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieProbablyNothingPropertyShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieVariableNothingVariableShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTypeAliasShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieTypeAliasByExpansionShortNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieImportFqNameForPackageNameIndex"/>
        <stubIndex implementation="com.huawei.cangjie.ide.stubindex.CangJieExtendClassNameIndex"/>

        <fileBasedIndex implementation="com.huawei.cangjie.ide.vfilefinder.CangJiePackageSourcesMemberNamesIndex"/>
        <!--        <fileBasedIndex implementation="com.huawei.cangjie.ide.vfilefinder.CangJieFIleIndexTest"/>-->

        <fileBasedIndex implementation="com.huawei.cangjie.ide.vfilefinder.CangJiePartialPackageNamesIndex"/>
        <fileBasedIndex implementation="com.huawei.cangjie.ide.vfilefinder.CangJieShortClassNameFileIndex"/>


        <idIndexer filetype="CangJie" implementationClass="com.huawei.cangjie.ide.search.CangJieIdIndexer"/>
        <todoIndexer filetype="CangJie" implementationClass="com.huawei.cangjie.ide.search.CangJieTodoIndexer"/>

        <indexPatternBuilder implementation="com.huawei.cangjie.ide.search.CangJieIndexPatternBuilder"/>

        <notificationGroup
                id="Recover CangJie Indices"
                displayType="STICKY_BALLOON"
                bundle="messages.CangJieBaseAnalysisBundle"
                key="cangjie.repair.indices.group.name"
        />
        <projectService
                serviceInterface="com.huawei.cangjie.resolve.lazy.declarations.DeclarationProviderFactoryService"
                serviceImplementation="com.huawei.cangjie.ide.stubindex.resolve.PluginDeclarationProviderFactoryService"/>

        <applicationService
                serviceInterface="com.huawei.cangjie.references.CjReferenceResolutionHelper"
                serviceImplementation="com.huawei.cangjie.references.CjReferenceResolutionHelperImpl"/>
        <registryKey key="cangjie.indices.short.names.filtering.enabled" defaultValue="true"
                     description="Filter irrelevant Kotlin FQNames by short name index"
                     restartRequired="true"/>

        <registryKey key="cangjie.indices.nested.access.enabled"
                     defaultValue="false"
                     description="Allows nested indices access"/>
        <registryKey key="cangjie.indices.timing.threshold.single"
                     defaultValue="2500"
                     description="Time threshold in ms to report slow index single get access"/>
        <registryKey key="cangjie.indices.timing.threshold.batch"
                     defaultValue="5000"
                     description="Time threshold in ms to report slow index batch (processAll-like) access"/>
        <registryKey key="cangjie.indices.timing.enabled"
                     defaultValue="false"
                     description="Allows indices access time tracking"/>
    </extensions>

    <projectListeners>
        <listener class="com.huawei.cangjie.ide.stubindex.resolve.CangJieRepairIdeAfterCorruptionNotification"
                  topic="com.huawei.cangjie.ide.stubindex.resolve.CangJieCorruptedIndexListener"
                  activeInHeadlessMode="false"
                  activeInTestMode="false"/>



    </projectListeners>
</idea-plugin>
