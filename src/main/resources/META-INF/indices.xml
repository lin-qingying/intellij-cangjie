<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">

        <stubElementTypeHolder externalIdPrefix="cangjie."
                               class="com.linqingying.cangjie.psi.stubs.elements.CjStubElementTypes"/>

        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelFunctionByPackageIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelTypeAliasByPackageIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelVariableByPackageIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelFunctionFqnNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieMainFunctionFqnNameIndex"/>

        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieMacroDeclarationByPackageIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieMacroDeclarationFqnNameIndex"/>

        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieMacroDeclarationShortNameIndex"/>


        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieFunctionShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieProbablyNothingFunctionShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJiePrimeSymbolNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieOverridableInternalMembersShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieExactPackagesIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieClassShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieEnumEntryShortNameIndex"/>

        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieSuperClassIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelTypeAliasFqNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelPropertyFqnNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelPropertyByPackageIndex"/>

        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelVariableFqnNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelClassByPackageIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieFullClassNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJiePropertyShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieVariableShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTopLevelExtensionsByReceiverTypeIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieProbablyNothingPropertyShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieVariableNothingVariableShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTypeAliasShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieTypeAliasByExpansionShortNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieImportFqNameForPackageNameIndex"/>
        <stubIndex implementation="com.linqingying.cangjie.ide.stubindex.CangJieExtendClassNameIndex"/>

        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJieMetadataFileIndex"/>
        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJieMetadataFilePackageIndex"/>
        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJieBuiltInsMetadataIndex"/>


        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJiePackageSourcesMemberNamesIndex"/>
        <!--        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJieFIleIndexTest"/>-->

        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJiePartialPackageNamesIndex"/>
        <fileBasedIndex implementation="com.linqingying.cangjie.ide.vfilefinder.CangJieShortClassNameFileIndex"/>


        <idIndexer filetype="CangJie" implementationClass="com.linqingying.cangjie.ide.search.CangJieIdIndexer"/>
        <todoIndexer filetype="CangJie" implementationClass="com.linqingying.cangjie.ide.search.CangJieTodoIndexer"/>

        <indexPatternBuilder implementation="com.linqingying.cangjie.ide.search.CangJieIndexPatternBuilder"/>

        <notificationGroup
                id="Recover CangJie Indices"
                displayType="STICKY_BALLOON"
                bundle="messages.CangJieAnalysisBundle"
                key="cangjie.repair.indices.group.name"
        />
        <projectService
                serviceInterface="com.linqingying.cangjie.resolve.lazy.declarations.DeclarationProviderFactoryService"
                serviceImplementation="com.linqingying.cangjie.ide.stubindex.resolve.PluginDeclarationProviderFactoryService"/>

        <applicationService
                serviceInterface="com.linqingying.cangjie.references.CjReferenceResolutionHelper"
                serviceImplementation="com.linqingying.cangjie.references.CjReferenceResolutionHelperImpl"/>
        <registryKey key="cangjie.indices.short.names.filtering.enabled" defaultValue="true"
                     description="Filter irrelevant CangJie FQNames by short name index"
                     restartRequired="true"/>

        <registryKey key="cangjie.indices.nested.access.enabled"
                     defaultValue="false"
                     description="Allows nested indices access"/>
        <registryKey key="cangjie.indices.timing.threshold.single"
                     defaultValue="2500"
                     description="Time threshold in ms to report slow index single get access"/>
        <registryKey key="cangjie.indices.timing.threshold.batch"
                     defaultValue="5000"
                     description="Time threshold in ms to report slow index batch (processAll-like) access"/>
        <registryKey key="cangjie.indices.timing.enabled"
                     defaultValue="false"
                     description="Allows indices access time tracking"/>


        <definitionsScopedSearch implementation="com.linqingying.cangjie.ide.search.CangJieDefinitionsSearcher"/>

    </extensions>
    <extensions defaultExtensionNs="com.linqingying.cangjie.ide.search">
        <directClassInheritorsSearch implementation="com.linqingying.cangjie.ide.search.CangJieDirectInheritorsSearcher"/>
        <classInheritorsSearch implementation="com.linqingying.cangjie.ide.search.CangJieInnerClassInheritorsSearcher"/>
        <classInheritorsSearch implementation="com.linqingying.cangjie.ide.search.CangJieClassInheritorsSearcher"/>

    </extensions>
    <extensionPoints>
        <extensionPoint qualifiedName="com.linqingying.cangjie.ide.search.classInheritorsSearch"
                        interface="com.intellij.util.QueryExecutor" dynamic="true"/>
        <extensionPoint qualifiedName="com.linqingying.cangjie.ide.search.directClassInheritorsSearch"
                        interface="com.intellij.util.QueryExecutor" dynamic="true"/>

    </extensionPoints>

    <projectListeners>
<!--        监听索引损坏-->
<!--        <listener class="com.linqingying.cangjie.ide.stubindex.resolve.CangJieRepairIdeAfterCorruptionNotification"-->
<!--                  topic="com.linqingying.cangjie.ide.stubindex.resolve.CangJieCorruptedIndexListener"-->
<!--                  activeInHeadlessMode="false"-->
<!--                  activeInTestMode="false"/>-->


    </projectListeners>
</idea-plugin>
