<idea-plugin>
    <!-- IntelliJ 平台文件类型相关扩展点配置 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. 文件类型图标提供器 -->
        <!-- CJPM项目文件图标提供器 -->
        <fileIconProvider implementation="cn.cangnova.cangjie.cjpm.icon.CjpmIconProvider"/>

        <!-- 2. 文件类型定义 -->
        <!-- 仓颉语言文件类型 -->
        <!--        文件类型-->
        <fileType name="CangJie"

                  language="CangJie"
                  implementationClass="cn.cangnova.cangjie.lang.CangJieFileType"
                  extensions="cj"
                  fieldName="INSTANCE"/>

        <fileType name="cj.macrocall"
                  language="CangJie"
                  implementationClass="cn.cangnova.cangjie.macro.file.CangJieMacroCallFileType"
                  extensions="cj.macrocall"

                  patterns="*.cj.macrocall"
        />
        <fileType name="cjd" fieldName="INSTANCE" extensions="cjd"
                  language="CangJie"
                  implementationClass="cn.cangnova.cangjie.lang.declarations.CangJieDeclarationsFileType"/>

        <!--<fileTypeFactory implementation="cn.cangnova.cangjie.macro.file.MacroCallFileTypeFactory"/>-->
    </extensions>

    <extensionPoints>
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.binaryExtension"
                interface="cn.cangnova.cangjie.ide.project.structure.CangJieBinaryExtension"
                dynamic="true"/>
    </extensionPoints>

</idea-plugin>