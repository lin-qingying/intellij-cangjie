<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceInterface="cn.cangnova.cangjie.resolve.CodeAnalyzerInitializer"
                serviceImplementation="cn.cangnova.cangjie.resolve.DummyCodeAnalyzerInitializer"/>
        <registryKey
                key="cangjie.dispatch.thread.resolve.check"
                description="Whether to enable the check for resolve activated from the write action"
                defaultValue="false"
                restartRequired="false"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.resolve.caches.CangJieCacheService"
                serviceImplementation="cn.cangnova.cangjie.resolve.caches.CangJieCacheServiceImpl"/>
        <registryKey
                key="cangjie.caches.fine.grained.entity.validation"
                description="Allow a fine grained cache entity validation"
                defaultValue="true"
                restartRequired="true"
        />
        <projectService
                serviceInterface="cn.cangnova.cangjie.ide.cache.trackers.ModuleDependencyProviderExtension"
                serviceImplementation="cn.cangnova.cangjie.ide.cache.trackers.ResolutionAnchorModuleDependencyProviderExtension"/>

        <registryKey key="cangjie.cache.packages.strong.map"
                     description="Hold info about packages using strong references instead of soft ones"
                     defaultValue="true"
                     restartRequired="true"/>


        <registryKey key="cangjie.resolve.cache.uses.perfile.cache"
                     description="Allows ResolveElementCache to reuse analysis results of PerFileCache"
                     defaultValue="true"
                     restartRequired="true"/>

        <projectService
                serviceInterface="cn.cangnova.cangjie.analyzer.LanguageSettingsProvider"
                serviceImplementation="cn.cangnova.cangjie.ide.projectStructure.IDELanguageSettingsProvider"/>

        <registryKey
                key="cangjie.caches.fine.grained.throttling.timeout.ms"
                description="Minimal time in ms between two successive invalidations of the same cache on low memory"
                defaultValue="5000"
                restartRequired="true"
        />

        <projectService
                serviceInterface="cn.cangnova.cangjie.ide.cache.project.ModelInfosCache"
                serviceImplementation="cn.cangnova.cangjie.ide.cache.project.FineGrainedIdeaModelInfosCache"/>



        <psi.treeChangePreprocessor implementation="cn.cangnova.cangjie.ide.cache.CangJiePackageStatementPsiTreeChangePreprocessor"/>

    </extensions>

    <projectListeners>


        <listener class="cn.cangnova.cangjie.ide.cache.PerModulePackageCacheService$PackageCacheBulkFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>

        <listener class="cn.cangnova.cangjie.ide.cache.PerModulePackageCacheService$PackageCacheModuleRootListener"
                  topic="com.intellij.openapi.roots.ModuleRootListener"/>
    </projectListeners>
</idea-plugin>
