<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceInterface="com.huawei.cangjie.resolve.CodeAnalyzerInitializer"
                serviceImplementation="com.huawei.cangjie.resolve.DummyCodeAnalyzerInitializer"/>
        <registryKey
                key="cangjie.dispatch.thread.resolve.check"
                description="Whether to enable the check for resolve activated from the write action"
                defaultValue="false"
                restartRequired="false"/>
        <projectService
                serviceInterface="com.huawei.cangjie.resolve.caches.CangJieCacheService"
                serviceImplementation="com.huawei.cangjie.resolve.caches.CangJieCacheServiceImpl"/>
        <registryKey
                key="cangjie.caches.fine.grained.entity.validation"
                description="Allow a fine grained cache entity validation"
                defaultValue="true"
                restartRequired="true"
        />

        <registryKey key="cangjie.cache.packages.strong.map"
                     description="Hold info about packages using strong references instead of soft ones"
                     defaultValue="true"
                     restartRequired="true"/>
        <projectService
                serviceInterface="com.huawei.cangjie.analyzer.LanguageSettingsProvider"
                serviceImplementation="com.huawei.cangjie.ide.projectStructure.IDELanguageSettingsProvider"/>

        <registryKey
                key="cangjie.caches.fine.grained.throttling.timeout.ms"
                description="Minimal time in ms between two successive invalidations of the same cache on low memory"
                defaultValue="5000"
                restartRequired="true"
        />

        <projectService
                serviceInterface="com.huawei.cangjie.ide.cache.project.ModelInfosCache"
                serviceImplementation="com.huawei.cangjie.ide.cache.project.FineGrainedIdeaModelInfosCache"/>

    </extensions>
</idea-plugin>
