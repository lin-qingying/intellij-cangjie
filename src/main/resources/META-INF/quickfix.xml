<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <xi:include href="/META-INF/intentions.xml" xpointer="xpointer(/idea-plugin/*)"/>


    <extensions defaultExtensionNs="cn.cangnova.cangjie">
        <quickFixContributor implementation="cn.cangnova.cangjie.ide.quickfix.QuickFixRegistrar"/>


    </extensions>


    <extensionPoints>
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.ide.codeInsight.unresolvedReferenceQuickFixProvider"
                interface="cn.cangnova.cangjie.ide.quickfix.UnresolvedReferenceQuickFixProvider"
                dynamic="true"/>
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.quickFixContributor"
                interface="cn.cangnova.cangjie.ide.quickfix.QuickFixContributor"
                dynamic="true"/>
    </extensionPoints>
</idea-plugin>
