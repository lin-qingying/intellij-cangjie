<idea-plugin>
    <!-- IntelliJ 平台高亮相关扩展点配置 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. 基础语法高亮配置 -->
        <!-- 语法高亮设置页面 - 用于配置语言的语法高亮颜色方案 -->
        <colorSettingsPage implementation="cn.cangnova.cangjie.highlighter.CangJieColorSettingsPage"/>
        <!-- 语法高亮工厂 - 负责创建语法高亮器实例 -->
        <lang.syntaxHighlighterFactory language="CangJie"
                                     implementationClass="cn.cangnova.cangjie.highlighter.CangJieSyntaxHighlighterFactory"/>

        <!-- 2. 高级高亮配置 -->
        <!-- 高亮处理工厂 - 用于在解析前进行代码高亮处理 -->
        <highlightingPassFactory
                implementation="cn.cangnova.cangjie.highlighter.CangJieBeforeResolveHighlightingPass$Registrar"/>
    </extensions>

    <!-- 自定义扩展点定义 -->
    <extensionPoints>
        <!-- 解析前高亮扩展点 - 允许其他插件在代码解析前添加自定义高亮 -->
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.beforeResolveHighlightingVisitor"
                interface="cn.cangnova.cangjie.highlighter.BeforeResolveHighlightingExtension"
                dynamic="true"/>
    </extensionPoints>
</idea-plugin>