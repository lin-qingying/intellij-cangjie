<idea-plugin allow-bundled-update="true">
    <!-- CJO 元数据服务配置 -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- CJO 包元数据服务
             项目级服务，提供统一的包元数据访问接口
             该服务在项目启动时主动初始化，监听 WorkspaceModel 变更事件
             preload="await" 确保在项目打开时立即初始化

             服务接口：CjoPackageService（公开接口，供外部使用）
             服务实现：CjoPackageServiceImpl（内部实现，不直接使用） -->
        <projectService
                serviceInterface="org.cangnova.cangjie.cjo.CjoPackageService"
                serviceImplementation="org.cangnova.cangjie.cjo.CjoPackageServiceImpl"
                  />

        <!-- CJO FullId 解析器服务
             项目级服务，用于解析跨包类型引用的 FullId
             该服务由 CjoPackageService 使用，提供跨包符号解析能力

             服务接口：CjoFullIdResolver（公开接口，供外部使用）
             服务实现：CjoFullIdResolverImpl（内部实现，不直接使用） -->
        <projectService
                serviceInterface="org.cangnova.cangjie.cjo.CjoFullIdResolver"
                serviceImplementation="org.cangnova.cangjie.cjo.CjoFullIdResolverImpl"/>

    </extensions>
</idea-plugin>