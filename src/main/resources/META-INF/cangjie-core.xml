        <!--SDK-->
        <sdkType implementation="com.huawei.cangjie.lang.sdk.CangJieSdkType"/>
        <projectSdkSetupValidator implementation="com.huawei.cangjie.lang.sdk.CangJieLanguageSdkSetupValidator"/>

