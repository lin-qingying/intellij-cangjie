<idea-plugin allow-bundled-update="true">
    <!-- IntelliJ 平台扩展点配置 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. 启动配置 -->
        <!-- 插件启动后执行的活动 -->
        <postStartupActivity implementation="org.cangnova.cangjie.CangJieStartupActivity"/>

        <!-- 2. 项目相关配置 -->
        <!-- 新项目向导 -->
        <newProjectWizard.languageGenerator
                implementation="org.cangnova.cangjie.ide.project.tools.projectWizard.CangJieGeneratorNewProjectWizard"/>
        <directoryProjectGenerator implementation="org.cangnova.cangjie.ide.newProject.CjDirectoryProjectGenerator"/>

        <!-- 模块构建器 -->
        <moduleBuilder
                builderClass="org.cangnova.cangjie.ide.module.CangJieModuleBuilder"/>

        <!-- 3. 项目设置配置 -->
        <!-- 主设置页面 -->
        <projectConfigurable instance="org.cangnova.cangjie.configurable.CangJieConfigurable"
                             groupId="language"
                             id="language.cangjie"
                             bundle="messages.CangJieBundle" key="CangJie"/>
        <!-- 语言服务器设置页面 -->
