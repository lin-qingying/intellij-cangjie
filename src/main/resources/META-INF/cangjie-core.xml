<idea-plugin allow-bundled-update="true" xmlns:xi="http://www.w3.org/2001/XInclude">


    <resource-bundle>messages.CangJieBaseHighlightingBundle</resource-bundle>
    <resource-bundle>messages.CangJieBundle</resource-bundle>


    <xi:include href="/META-INF/codeInsight.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="com.intellij">

        <!-- 编辑器执行配置 -->
        <runLineMarkerContributor language="CangJie"
                                  implementationClass="com.huawei.cangjie.idea.run.CjRunLineMarkersProvider"/>

        <!--        文件索引-->
        <!--        <fileBasedIndex implementation=""></fileBasedIndex>-->


        <!--        插件启动初始化-->
        <!--        <applicationService serviceImplementation="com.huawei.cangjie.CangJieStartupActivity" serviceInterface="com.intellij.openapi.startup.StartupActivity"/>-->
        <!--        <postStartupActivity implementation="com.huawei.cangjie.idea.project.CangJieProjectActivity"/>-->
        <additionalLibraryRootsProvider
                implementation="com.huawei.cangjie.cjpm.project.workspace.CjAdditionalLibraryRootsProvider"/>

        <!--        编辑器自动插入-->
        <typedHandler implementation="com.huawei.cangjie.idea.editor.CangJieTypedHandler"/>
        <typedHandler implementation="com.huawei.cangjie.idea.editor.CDocTypedHandler"/>
        <typedHandler implementation="com.huawei.cangjie.idea.editor.CangJieRawStringTypedHandler"/>
        <backspaceHandlerDelegate implementation="com.huawei.cangjie.idea.editor.CangJieBackspaceHandlerDelegate"/>
        <lang.braceMatcher implementationClass="com.huawei.cangjie.idea.editor.CangJiePairedBraceMatcher"
                           language="CangJie"/>
        <quoteHandler fileType="CangJie" className="com.huawei.cangjie.idea.editor.CangJieQuoteHandler"/>
        <backspaceHandlerDelegate implementation="com.huawei.cangjie.idea.editor.CangJieRawStringBackspaceHandler"/>
        <backspaceHandlerDelegate
                implementation="com.huawei.cangjie.idea.editor.CangJieStringTemplateBackspaceHandler"/>

        <!--        <treeStructureProvider implementation="com.huawei.cangjie.idea.projectView.CangJieExpandNodeProjectViewProvider" order="last"/>-->


        <!-- PSI 管理器 -->

        <!--        <lang.fileViewProviderFactory language="CangJie" implementationClass="com.huawei.cangjie.lang.core.psi.CjFileViewProviderFactory"/>-->


        <!--        <annotator language="CangJie" implementationClass="com.huawei.cangjie.ide.annotator.CjErrorAnnotator"/>-->
        <!--        <highlightRangeExtension implementation="com.huawei.cangjie.ide.annotator.CjErrorAnnotator"/>-->

        <lang.documentationProvider language="CangJie"
                                    implementationClass="com.huawei.cangjie.idea.CangJieDocumentationProvider"
                                    order="first"/>

        <!--        文件类型-->
        <fileType name="CangJie"
                  language="CangJie"
                  implementationClass="com.huawei.cangjie.lang.CangJieFileType"
                  extensions="cj"
                  fieldName="INSTANCE"/>
        <internalFileTemplate name="CangJie File"/>



        <!--       PSI解析 -->
                <lang.parserDefinition language="CangJie"
                                       implementationClass="com.huawei.cangjie.parsing.CangJieParserDefinition"/>
        <!--antlr psi解析-->
<!--        <lang.parserDefinition language="CangJie"-->
<!--                               implementationClass="antlr.ANTLRCangJieParserDefinition"/>-->



        <!--语法高亮-->
        <colorSettingsPage implementation="com.huawei.cangjie.highlighter.CangJieColorSettingsPage"/>
        <lang.syntaxHighlighterFactory language="CangJie"
                                       implementationClass="com.huawei.cangjie.highlighter.CangJieSyntaxHighlighterFactory"/>


        <stubElementTypeHolder class="com.huawei.cangjie.psi.stubs.elements.CjStubElementTypes"
                               externalIdPrefix="cangjie."/>


        <highlightingPassFactory
                implementation="com.huawei.cangjie.highlighter.CangJieBeforeResolveHighlightingPass$Registrar"/>


        <newProjectWizard.language
                implementation="com.huawei.cangjie.idea.project.tools.projectWizard.CangJieNewProjectWizard"/>
        <moduleBuilder
                builderClass="com.huawei.cangjie.idea.project.tools.projectWizard.wizard.CangJieModuleBuilder"/>


        <!--运行-->
        <!--        cjpm运行任务-->
        <runConfigurationProducer implementation="com.huawei.cangjie.idea.run.cjpm.CjpmRunConfigurationProducer"
                                  id="CjpmRunConfigurationProducer"/>
        <configurationType
                implementation="com.huawei.cangjie.idea.run.cjpm.CjpmCommandConfigurationType"
                id="CjpmRunConfiguration"/>


        <!--    行配置之前执行的步骤   -->
        <stepsBeforeRunProvider
                implementation="com.huawei.cangjie.idea.run.cjpm.runconfig.buildtool.CjpmBuildTaskProvider"/>

        <programRunner implementation="com.huawei.cangjie.idea.run.cjpm.CjpmCommandRunner"/>


        <!--        <analyzeStacktraceFilter implementation="com.huawei.cangjie.idea.run.cjpm.runconfig.buildtool.CjBacktraceFilter"/>-->

        <!--        构建-->
        <projectTaskRunner implementation="com.huawei.cangjie.idea.run.cjpm.runconfig.buildtool.CjpmBuildTaskRunner"/>

        <!--        cjc-->
        <!--        <configurationType-->
        <!--                implementation="com.huawei.cangjie.idea.run.cjc.CjcRunConfigurationType"-->
        <!--                id="CjcRunConfiguration"/>-->
        <!--        <runConfigurationProducer implementation="com.huawei.cangjie.idea.run.cjc.CjcRunConfigurationProducer" id="CjcRunConfigurationProducer"/>-->


        <projectConfigurable instance="com.huawei.cangjie.cjpm.project.configurable.CjProjectConfigurable"
                             groupId="language"
                             id="language.cangjie"
                             bundle="messages.CangJieBundle" key="settings.cangjie.toolchain.name"/>
        <!--注释-->
        <lang.commenter language="CangJie" implementationClass="com.huawei.cangjie.idea.commenter.CjCommenter"/>


        <executionTargetLanguageRuntimeType
                implementation="com.huawei.cangjie.idea.run.cjpm.runconfig.CjLanguageRuntimeType"/>
        <applicationService
                serviceImplementation="com.huawei.cangjie.idea.run.cjpm.runconfig.CjRunConfigurationExtensionManager"/>


        <applicationService
                serviceImplementation="com.huawei.cangjie.idea.completion.FirCompletionDummyIdentifierProviderService"
                serviceInterface="com.huawei.cangjie.idea.completion.CompletionDummyIdentifierProviderService"/>

        <applicationService
                serviceInterface="com.huawei.cangjie.psi.stubs.elements.StubIndexService"
                serviceImplementation="com.huawei.cangjie.idea.stubindex.IdeStubIndexService"/>

        <!--        <applicationService-->
        <!--                serviceInterface="com.huawei.cangjie.idea.liveTemplates.ShortenReferencesFacility"-->
        <!--                serviceImplementation="com.huawei.cangjie.idea.liveTemplates.CangJieShortenReferencesFacility"/>-->
        <projectService serviceInterface="com.huawei.cangjie.cjpm.project.model.CjpmProjectsService"
                        serviceImplementation="com.huawei.cangjie.cjpm.project.model.impl.CjpmProjectsServiceImpl"
        />
        <projectService serviceImplementation="com.huawei.cangjie.cjpm.project.settings.CangJieProjectSettingsService"/>
        <projectService
                serviceImplementation="com.huawei.cangjie.cjpm.project.settings.CjExternalLinterProjectSettingsService"/>

        <applicationService serviceImplementation="com.huawei.cangjie.idea.newProject.state.CjUserTemplatesState"/>

        <!--        <projectService serviceImplementation="com.huawei.cangjie.idea.run.cjpm.back.CangJieProjectSettingsService"/>-->
        <!--代码补全-->
        <completion.contributor
                language="CangJie"
                id="CangJieCompletionContributor"
                order="first, after liveTemplates"
                implementationClass="com.huawei.cangjie.idea.completion.CangJieCompletionContributor"/>

        <!--        <applicationService serviceInterface="com.huawei.cangjie.psi.CangJieDeclarationNavigationPolicy"-->
        <!--                        serviceImplementation="com.huawei.cangjie.psi.CangJieDeclarationNavigationPolicyImpl"/>-->
        <registryKey
                key="cangjie.disable.auto.completion.inside.expression"
                description="Disables auto-completion inside expressions"
                defaultValue="false"
                restartRequired="false"/>
        <registryKey key="org.cangjie.cjpm.lock.update.delay.threshold" defaultValue="5000" restartRequired="false"
                     description="Delay in ms between Cjpm metadata call and changes in module-lock.json
                     when automatic project structure reload doesn't occur"/>
        <registryKey key="com.huawei.cangjie.cjpm.new.auto.import"
                     defaultValue="true"
                     description="Enable new Cjpm project model reloading"
                     restartRequired="true"/>

        <registryKey key="cangjie.create.sealed.templates.enabled"
                     defaultValue="false"
                     description="Enables dedicated Sealed class/interface templates in File-New-CangJie File"/>
        <registryKey key="com.huawei.cangjie.cjpm.test.nocapture" defaultValue="false" restartRequired="false"
                     description="Add `--nocapture` flag to the test command line and show test results in
                     Run Tool Window instead of raw console"/>
        <notificationGroup id="CangJie Plugin" displayType="BALLOON" bundle="messages.CangJieBundle"
                           key="notification.group.cangjie.plugin"/>
        <notificationGroup id="CangJie Build Log" bundle="messages.CangJieBundle" displayType="NONE"
                           key="notification.group.cangjie.plugin"/>

        <notificationGroup id="jps configuration error"
                           toolWindowId="Build"
                           displayType="TOOL_WINDOW"
                           bundle="messages.CangJieCompilerBundle"
                           key="notification.group.title.jps.cannot.start.compiler"/>

        <runAnything.executionProvider order="after RunAnythingRunConfigurationProvider"
                                       implementation="com.huawei.cangjie.idea.actions.runAnything.cjpm.CjpmRunAnythingProvider"/>
        <!--        工具栏-->

        <toolWindow id="Cjpm"
                    anchor="right"
                    factoryClass="com.huawei.cangjie.cjpm.project.toolwindow.CjpmToolWindowFactory"

        />

        <projectConfigurable provider="com.huawei.cangjie.cjpm.project.configurable.CjpmBuildToolConfigurableProvider"
                             parentId="build.tools"
                             id="language.cangjie.build.tool.cjpm"
                             bundle="messages.CangJieBundle" key="settings.cangjie.cjpm.name"/>
        <!-- Notifications -->

        <editorNotificationProvider
                implementation="com.huawei.cangjie.idea.notifications.MissingToolchainNotificationProvider"/>
        <editorNotificationProvider
                implementation="com.huawei.cangjie.idea.notifications.NoCjpmProjectNotificationProvider"/>


        <statusBarWidgetFactory id="cangjieExternalLinterWidget"
                                implementation="com.huawei.cangjie.idea.status.CjExternalLinterWidgetFactory"
                                order="first"/>


        <fileIconProvider implementation="com.huawei.cangjie.icon.CjpmIconProvider"/>


        <!--        <projectService-->
        <!--                serviceInterface="com.huawei.cangjie.cjpm.CjpmConstantsService"-->
        <!--                serviceImplementation="com.huawei.cangjie.cjpm.CjpmConstantsServiceImpl"-->


        <!--        />-->


        <projectService
                serviceInterface="com.huawei.cangjie.psi.CangJieReferenceProvidersService"
                serviceImplementation="com.huawei.cangjie.idea.references.CjIdeReferenceProviderService"/>


        <projectService serviceInterface="com.huawei.cangjie.idea.references.CangJieReferenceProviderContributor"
                        serviceImplementation="com.huawei.cangjie.references.CangJieReferenceContributor"/>
    </extensions>

    <!--        监听-->
    <applicationListeners>
        <!--        <listener class="com.huawei.cangjie.idea.project.CangJieProjectManagerListener" topic="com.intellij.openapi.project.ProjectManagerListener"/>-->

        <!--        <listener class="com.huawei.cangjie.lang.sdk.CangJieProjectSdkTableListener" topic="com.intellij.openapi.projectRoots.ProjectJdkTable$Listener"/>-->
    </applicationListeners>

    <projectListeners>
        <listener class="com.huawei.cangjie.idea.status.CjExternalLinterWidgetUpdater"
                  topic="com.huawei.cangjie.cjpm.project.model.CjpmProjectsService$CjpmProjectsListener"/>
    </projectListeners>

    <extensionPoints>
        <extensionPoint qualifiedName="com.huawei.cangjie.toolchainProvider"
                        interface="com.huawei.cangjie.cjpm.toolchain.CjToolchainProvider"
                        dynamic="true"/>
        <!--        <extensionPoint qualifiedName="com.huawei.cangjie.toolchainProvider"-->
        <!--                        interface="com.huawei.cangjie.idea.run.cjpm.back.CjToolchainProvider"-->
        <!--                        dynamic="true"/>-->

        <!--        <extensionPoint qualifiedName="com.huawei.cangjie.toolchainFlavor"-->
        <!--                        interface="com.huawei.cangjie.idea.run.cjpm.back.CjToolchainFlavor"-->
        <!--                        dynamic="true"/>-->

        <extensionPoint qualifiedName="com.huawei.cangjie.toolchainFlavor"
                        interface="com.huawei.cangjie.cjpm.toolchain.flavors.CjToolchainFlavor"
                        dynamic="true"/>
        <extensionPoint
                qualifiedName="com.huawei.cangjie.beforeResolveHighlightingVisitor"
                interface="com.huawei.cangjie.highlighter.BeforeResolveHighlightingExtension"
                dynamic="true"/>
        <extensionPoint
                qualifiedName="com.huawei.cangjie.completionExtension"
                interface="com.huawei.cangjie.idea.completion.CangJieCompletionExtension" dynamic="true"/>

        <extensionPoint qualifiedName="com.huawei.cangjie.runConfigurationExtension"
                        interface="com.huawei.cangjie.idea.run.cjpm.runconfig.CjpmCommandConfigurationExtension"
                        dynamic="true"/>
        <extensionPoint
                qualifiedName="com.intellij.newProjectWizard.CangJie.buildSystem"
                interface="com.huawei.cangjie.idea.project.tools.projectWizard.BuildSystemCangJieNewProjectWizard"
                dynamic="true"/>
        <extensionPoint
                qualifiedName="com.huawei.cangjie.newFileHook"
                interface="com.huawei.cangjie.idea.actions.NewCangJieFileHook"
                dynamic="true"/>

        <extensionPoint
                qualifiedName="com.huawei.cangjie.projectConfigurator"
                interface="com.huawei.cangjie.idea.configuration.CangJieProjectConfigurator"
                dynamic="true"/>


    </extensionPoints>


    <actions>
        <action id="CjpmAction" class="com.huawei.cangjie.idea.run.modulejson.CjpmUpdateAction"
                text="run cjpm update">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <!--          icon="com.huawei.cangjie.idea.icons.CangJieIcons.CANGJIE_FILE"    -->
        <action id="CangJie.NewFile" class="com.huawei.cangjie.idea.actions.NewCangJieFileAction"
                text="add Cangjie File"
        >

            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewGroup1"/>
        </action>


        <!--        CJPM-->

        <action id="Cjpm.AttachCjpmProject"
                class="com.huawei.cangjie.cjpm.project.model.AttachCjpmProjectAction"
                icon="AllIcons.General.Add"/>

        <!--        更新cjpm项目结构-->
        <action id="Cjpm.RefreshCjpmProject"
                class="com.huawei.cangjie.idea.actions.RefreshCjpmProjectsAction"
                icon="AllIcons.Actions.Refresh"/>

        <action id="Cjpm.ShowSettings"
                class="com.huawei.cangjie.idea.actions.CjpmEditSettingsAction"
                icon="AllIcons.General.Settings">
        </action>


        <action id="Cjpm.RunCjpmCommand"
                class="com.huawei.cangjie.cjpm.runconfig.command.RunCjpmCommandAction"
        />
        <group id="CangJie.Cjpm">
            <reference id="Cjpm.RefreshCjpmProject"/>
            <reference id="Cjpm.AttachCjpmProject"/>
            <!--            <reference id="Cjpm.DetachCjpmProject"/>-->
            <separator/>
            <reference id="Cjpm.RunCjpmCommand"/>
            <!--            <reference id="Cjpm.RunExternalLinter"/>-->
            <!--            <reference id="Cjpm.RustfmtCjpmProject"/>-->
            <separator/>
            <reference id="ExpandAll"/>
            <reference id="CollapseAll"/>
            <separator/>
            <reference id="Cjpm.ShowSettings"/>
        </group>

    </actions>


    <!--    <extensions defaultExtensionNs="com.jetbrains">-->
    <!--        <performancePlugin.commandProvider implementation="com.huawei.cangjie.idea.performancePlugin.CangJiePluginCommandProvider"/>-->
    <!--    </extensions>-->


    <extensions defaultExtensionNs="com.intellij">

        <internalFileTemplate name="CangJie Class"/>

    </extensions>

    <extensions defaultExtensionNs="lsp">

        <!-- LSP -->
        <!--        <serverSupportProvider implementation="com.huawei.cangjie.lang.lsp.CangJieLspServerSupportProvider"/>-->


    </extensions>


    <extensions defaultExtensionNs="com.huawei.cangjie">
        <!-- Toolchains -->
        <toolchainFlavor id="cangjie.cjpmToolchainFlavor"
                         implementation="com.huawei.cangjie.cjpm.toolchain.flavors.CjpmToolchainFlavor"
                         order="first"/>
        <toolchainFlavor id="cangjie.winToolchainFlavor"
                         implementation="com.huawei.cangjie.cjpm.toolchain.flavors.CjWinToolchainFlavor"/>

        <toolchainProvider implementation="com.huawei.cangjie.cjpm.toolchain.CjLocalToolchainProvider"/>

        <toolchainFlavor id="cangjie.wslToolchainFlavor"
                         implementation="com.huawei.cangjie.cjpm.toolchain.wsl.CjWslToolchainFlavor"/>
    </extensions>

</idea-plugin>
