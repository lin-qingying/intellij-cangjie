<idea-plugin allow-bundled-update="true" xmlns:xi="http://www.w3.org/2001/XInclude">


    <resource-bundle>messages.CangJieHighlightingBundle</resource-bundle>
    <resource-bundle>messages.CangJieBundle</resource-bundle>


    <extensions defaultExtensionNs="com.intellij">

        <!-- 编辑器执行配置 -->
        <runLineMarkerContributor language="CangJie"
                                  implementationClass="cn.cangnova.cangjie.ide.run.CjRunLineMarkersProvider"/>
        <editorSmartKeysConfigurable instance="cn.cangnova.cangjie.ide.editor.CangJieEditorOptionsConfigurable"/>
        <lang.foldingBuilder language="CangJie"
                             implementationClass="cn.cangnova.cangjie.ide.editor.folding.CangJieFoldingBuilder"/>



        <postStartupActivity implementation="cn.cangnova.cangjie.CangJieStartupActivity"/>

        <!--        编辑器自动插入-->
        <typedHandler implementation="cn.cangnova.cangjie.ide.editor.CangJieTypedHandler"/>
        <typedHandler implementation="cn.cangnova.cangjie.ide.editor.CDocTypedHandler"/>
        <typedHandler implementation="cn.cangnova.cangjie.ide.editor.CangJieRawStringTypedHandler"/>
        <backspaceHandlerDelegate implementation="cn.cangnova.cangjie.ide.editor.CangJieBackspaceHandlerDelegate"/>
        <lang.braceMatcher implementationClass="cn.cangnova.cangjie.ide.editor.CangJiePairedBraceMatcher"
                           language="CangJie"/>
        <quoteHandler fileType="CangJie" className="cn.cangnova.cangjie.ide.editor.CangJieQuoteHandler"/>
        <backspaceHandlerDelegate implementation="cn.cangnova.cangjie.ide.editor.CangJieRawStringBackspaceHandler"/>
        <backspaceHandlerDelegate
                implementation="cn.cangnova.cangjie.ide.editor.CangJieStringTemplateBackspaceHandler"/>



        <!--        文件类型-->
        <fileType name="CangJie"
                  language="CangJie"
                  implementationClass="cn.cangnova.cangjie.lang.CangJieFileType"
                  extensions="cj"
                  fieldName="INSTANCE"/>



        <!--      PSI解析-->
        <lang.parserDefinition language="CangJie"
                               implementationClass="cn.cangnova.cangjie.parsing.CangJieParserDefinition"/>


        <!--语法高亮-->
        <colorSettingsPage implementation="cn.cangnova.cangjie.highlighter.CangJieColorSettingsPage"/>
        <lang.syntaxHighlighterFactory language="CangJie"
                                       implementationClass="cn.cangnova.cangjie.highlighter.CangJieSyntaxHighlighterFactory"/>


        <stubElementTypeHolder class="cn.cangnova.cangjie.psi.stubs.elements.CjStubElementTypes"
                               externalIdPrefix="cangjie."/>


        <highlightingPassFactory
                implementation="cn.cangnova.cangjie.highlighter.CangJieBeforeResolveHighlightingPass$Registrar"/>

        <newProjectWizard.languageGenerator
                implementation="cn.cangnova.cangjie.ide.project.tools.projectWizard.CangJieGeneratorNewProjectWizard"/>

        <moduleBuilder
                builderClass="cn.cangnova.cangjie.ide.module.CangJieModuleBuilder"/>


        <!--运行-->
        <!--        cjpm运行任务-->
        <runConfigurationProducer implementation="cn.cangnova.cangjie.ide.run.cjpm.CjpmRunConfigurationProducer"
                                  id="CjpmRunConfigurationProducer"/>
        <configurationType
                implementation="cn.cangnova.cangjie.ide.run.cjpm.CjpmCommandConfigurationType"
                id="CjpmRunConfiguration"/>


        <!--    行配置之前执行的步骤   -->
        <stepsBeforeRunProvider
                implementation="cn.cangnova.cangjie.ide.run.cjpm.runconfig.buildtool.CjpmBuildTaskProvider"/>

        <programRunner implementation="cn.cangnova.cangjie.ide.run.cjpm.CjpmCommandRunner"/>



        <!--        构建-->
        <projectTaskRunner
                implementation="cn.cangnova.cangjie.ide.run.cjpm.runconfig.buildtool.CjpmBuildTaskRunner"/>


        <directoryProjectGenerator implementation="cn.cangnova.cangjie.ide.newProject.CjDirectoryProjectGenerator"/>

        <projectConfigurable instance="cn.cangnova.cangjie.configurable.CangJieConfigurable"
                             groupId="language"
                             id="language.cangjie"
                             bundle="messages.CangJieBundle" key="CangJie"/>
        <projectConfigurable instance="cn.cangnova.cangjie.configurable.CangJieLanguageServerConfigurable"
                             parentId="language.cangjie"
                             groupId="language.cangjie"
                             id="language.cangjie.languageServer"
                             bundle="messages.CangJieBundle" key="CangJie.languageServer"/>
        <projectConfigurable instance="cn.cangnova.cangjie.configurable.CangJieLspConfigurable"
                             parentId="language.cangjie.languageServer"
                             groupId="language.cangjie.languageServer"
                             id="language.cangjie.languageServer.lsp"
                             bundle="messages.CangJieBundle" key="CangJie.languageServer.lsp"/>
        <projectConfigurable instance="cn.cangnova.cangjie.configurable.CangJieAstAnalyzerConfigurable"
                             parentId="language.cangjie.languageServer"
                             groupId="language.cangjie.languageServer"
                             id="language.cangjie.languageServer.ast"
                             bundle="messages.CangJieBundle" key="CangJie.languageServer.astanalyzer"/>


        <!--注释-->
        <lang.commenter language="CangJie" implementationClass="cn.cangnova.cangjie.ide.commenter.CjCommenter"/>
        <!--结构视图-->
        <lang.psiStructureViewFactory
                language="CangJie"
                implementationClass="cn.cangnova.cangjie.ide.structureView.CangJieStructureViewFactory"/>
        <typeHierarchyProvider
                language="CangJie"
                implementationClass="cn.cangnova.cangjie.ide.hierarchy.CangJieTypeHierarchyProvider"/>
        <executionTargetLanguageRuntimeType
                implementation="cn.cangnova.cangjie.ide.run.cjpm.runconfig.CjLanguageRuntimeType"/>
        <applicationService
                serviceImplementation="cn.cangnova.cangjie.ide.run.cjpm.runconfig.CjRunConfigurationExtensionManager"/>

        <applicationService
                serviceInterface="cn.cangnova.cangjie.ide.debugger.CodeFragmentContextTuner"
                serviceImplementation="cn.cangnova.cangjie.ide.debugger.CangJieCodeFragmentContextTuner"/>


        <applicationService
                serviceInterface="cn.cangnova.cangjie.psi.stubs.elements.StubIndexService"
                serviceImplementation="cn.cangnova.cangjie.ide.stubindex.IdeStubIndexService"/>

        <projectService serviceInterface="cn.cangnova.cangjie.cjpm.project.model.CjpmProjectsService"
                        serviceImplementation="cn.cangnova.cangjie.cjpm.project.model.impl.CjpmProjectsServiceImpl"
        />
        <projectService
                serviceImplementation="cn.cangnova.cangjie.cjpm.project.settings.CjExternalLinterProjectSettingsService"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.ide.imports.ImportInsertHelper"
                serviceImplementation="cn.cangnova.cangjie.ide.imports.ImportInsertHelperImpl"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.psi.CangJiePsiFacade"
                serviceImplementation="cn.cangnova.cangjie.psi.DefaultCangJiePsiFacade"/>
        <applicationService
                serviceInterface="cn.cangnova.cangjie.ide.CangJieIconProviderService"
                serviceImplementation="cn.cangnova.cangjie.ide.CangJieIconProviderService$CompilerCangJieFileIconProviderService"
        />
        <projectService
                serviceInterface="cn.cangnova.cangjie.metadata.CangJieBuiltInDecompilationInterceptor"
                serviceImplementation="cn.cangnova.cangjie.metadata.IdeCangJieBuiltInDecompilationInterceptor"
        />
        <applicationService
                serviceInterface="cn.cangnova.cangjie.metadata.CangJieBuiltInStubVersionOffsetProvider"
                serviceImplementation="cn.cangnova.cangjie.metadata.IdeCangJieBuiltInStubVersionOffsetProvider"
        />
        <projectService serviceInterface="cn.cangnova.cangjie.metadata.decompiler.BuiltInsVirtualFileProvider"
                        serviceImplementation="cn.cangnova.cangjie.metadata.decompiler.IdeBuiltInsVirtualFileProviderImpl"/>
        <registryKey
                key="cangjie.enable.inlay.hint.for.lambda.return.type"
                description="Show inlay hint for lambda return type"
                defaultValue="false"
                restartRequired="false"/>
        <applicationService serviceImplementation="cn.cangnova.cangjie.ide.newProject.state.CjUserTemplatesState"/>

        <projectService serviceInterface="cn.cangnova.cangjie.references.ReadWriteAccessChecker"
                        serviceImplementation="cn.cangnova.cangjie.references.ReadWriteAccessCheckerDescriptorsImpl"/>
        <projectService serviceInterface="cn.cangnova.cangjie.ide.vfilefinder.VirtualFileFinderFactory"
                        serviceImplementation="cn.cangnova.cangjie.ide.vfilefinder.IdeVirtualFileFinderFactory"/>
        <iconProvider implementation="cn.cangnova.cangjie.ide.CangJieIconProvider"/>
        <treeStructureProvider
                implementation="cn.cangnova.cangjie.ide.projectView.CangJieSelectInProjectViewProvider"/>
        <treeStructureProvider
                implementation="cn.cangnova.cangjie.ide.projectView.CangJieExpandNodeProjectViewProvider"
                order="last"/>

        <projectService
                serviceInterface="cn.cangnova.cangjie.ide.projectStructure.LibraryUsageIndex"
                serviceImplementation="cn.cangnova.cangjie.ide.projectStructure.LibraryUsageIndexImpl"/>
        <registryKey
                key="cangjie.disable.auto.completion.inside.expression"
                description="Disables auto-completion inside expressions"
                defaultValue="false"
                restartRequired="false"/>
        <registryKey key="org.cangjie.cjpm.lock.update.delay.threshold" defaultValue="5000" restartRequired="false"
                     description="Delay in ms between Cjpm metadata call and changes in module-lock.json
                     when automatic project structure reload doesn't occur"/>
        <registryKey key="cn.cangnova.cangjie.cjpm.new.auto.import"
                     defaultValue="true"
                     description="Enable new Cjpm project model reloading"
                     restartRequired="true"/>
        <registryKey key="sdk.downloader.url" description="Custom URL to download the list of available SDKs"
                     defaultValue=""/>
        <registryKey key="sdk.downloader.reuse.installed" defaultValue="true"
                     description="Allow to reuse locally installed with the SDK Downloader SDK instead of download it again"/>
        <registryKey key="sdk.downloader.reuse.downloading" defaultValue="true"
                     description="Allow to reuse currently downloading with the SDK Downloader SDK instead of downloading it again"/>

        <registryKey key="cangjie.create.sealed.templates.enabled"
                     defaultValue="false"
                     description="Enables dedicated Sealed class/interface templates in File-New-CangJie File"/>
        <registryKey key="cn.cangnova.cangjie.cjpm.test.nocapture" defaultValue="false" restartRequired="false"
                     description="Add `--nocapture` flag to the test command line and show test results in
                     Run Tool Window instead of raw console"/>
        <notificationGroup id="CangJie Plugin" displayType="BALLOON" bundle="messages.CangJieBundle"
                           key="notification.group.cangjie.plugin"/>
        <notificationGroup id="CangJie Build Log" bundle="messages.CangJieBundle" displayType="NONE"
                           key="notification.group.cangjie.plugin"/>

        <notificationGroup id="jps configuration error"
                           toolWindowId="Build"
                           displayType="TOOL_WINDOW"
                           bundle="messages.CangJieCompilerBundle"
                           key="notification.group.title.jps.cannot.start.compiler"/>

        <runAnything.executionProvider order="after RunAnythingRunConfigurationProvider"
                                       implementation="cn.cangnova.cangjie.ide.actions.runAnything.cjpm.CjpmRunAnythingProvider"/>
        <!--        工具栏-->
        <toolWindow id="Cjpm"
                    anchor="right"
                    factoryClass="cn.cangnova.cangjie.cjpm.project.toolwindow.CjpmToolWindowFactory"

        />
        <!--        文档-->
        <toolWindow id="cangjie_doc"
                    anchor="right"
                    factoryClass="cn.cangnova.cangjie.toolwindow.doc.CangJieDocWindowFactory"

        />

        <projectConfigurable
                provider="cn.cangnova.cangjie.cjpm.project.configurable.CjpmBuildToolConfigurableProvider"
                parentId="build.tools"
                id="language.cangjie.build.tool.cjpm"
                bundle="messages.CangJieBundle" key="settings.cangjie.cjpm.name"/>
        <!-- Notifications -->

        <editorNotificationProvider
                implementation="cn.cangnova.cangjie.ide.notifications.MissingToolchainNotificationProvider"/>
        <editorNotificationProvider
                implementation="cn.cangnova.cangjie.ide.notifications.NoCjpmProjectNotificationProvider"/>


        <statusBarWidgetFactory id="cangjieExternalLinterWidget"
                                implementation="cn.cangnova.cangjie.ide.status.CjExternalLinterWidgetFactory"
                                order="first"/>
        <psi.treeChangeListener implementation="cn.cangnova.cangjie.dag.DependencyGraphListener"/>


        <!--        引用搜索-->
        <projectService
                serviceInterface="cn.cangnova.cangjie.psi.CangJieReferenceProvidersService"
                serviceImplementation="cn.cangnova.cangjie.references.CjIdeReferenceProviderService"/>


        <fileIconProvider implementation="cn.cangnova.cangjie.icon.CjpmIconProvider"/>



        <projectService serviceInterface="cn.cangnova.cangjie.references.CangJieReferenceProviderContributor"
                        serviceImplementation="cn.cangnova.cangjie.references.CangJieReferenceContributor"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.analyzer.lifetime.CjLifetimeTokenProvider"
                serviceImplementation="cn.cangnova.cangjie.analyzer.lifetime.CjReadActionConfinementLifetimeTokenProvider"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.analyzer.ProjectStructureProvider"
                serviceImplementation="cn.cangnova.cangjie.analyzer.ProjectStructureProviderIdeImpl"/>

        <projectService
                serviceInterface="cn.cangnova.cangjie.analyzer.CjAnalysisFacade"
                serviceImplementation="cn.cangnova.cangjie.analyzer.IdeCjAnalysisFacade"/>

        <projectService
                serviceInterface="cn.cangnova.cangjie.analyzer.session.CjAnalysisSessionProvider"
                serviceImplementation="cn.cangnova.cangjie.analyzer.session.CjAnalysisSessionProviderImpl"/>
        <projectService
                serviceInterface="cn.cangnova.cangjie.ide.cdoc.CDocLinkResolutionService"
                serviceImplementation="cn.cangnova.cangjie.ide.cdoc.IdeCDocLinkResolutionService"/>

        <projectService
                serviceInterface="cn.cangnova.cangjie.NotPropertiesService"
                serviceImplementation="cn.cangnova.cangjie.ide.intentions.NotPropertiesServiceImpl"/>
    </extensions>
    <xi:include href="/META-INF/codeInsight.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/searching.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/quickfix.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/refactoring.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/navigation.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/completion.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <!--    <xi:include href="/META-INF/diagrams.xml" xpointer="xpointer(/idea-plugin/*)"/>-->
    <xi:include href="/META-INF/file-types.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="/META-INF/cangjie-filetype.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <!--        监听-->
    <applicationListeners>
        <!--        <listener class="cn.cangnova.cangjie.ide.project.CangJieProjectManagerListener" topic="com.intellij.openapi.project.ProjectManagerListener"/>-->

        <!--        <listener class="cn.cangnova.cangjie.lang.sdk.CangJieProjectSdkTableListener" topic="com.intellij.openapi.projectRoots.ProjectJdkTable$Listener"/>-->
    </applicationListeners>

    <projectListeners>


        <listener class="cn.cangnova.cangjie.ide.status.CjExternalLinterWidgetUpdater"
                  topic="cn.cangnova.cangjie.cjpm.project.model.CjpmProjectsService$CjpmProjectsListener"/>
    </projectListeners>

    <extensionPoints>

        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.ide.caches.resolve.resolveOptimizingOptionsProvider"
                interface="cn.cangnova.cangjie.resolve.caches.ResolveOptimizingOptionsProvider"
                dynamic="true"/>
        <!--        工具链  多平台支持-->
        <extensionPoint qualifiedName="cn.cangnova.cangjie.toolchainProvider"
                        interface="cn.cangnova.cangjie.cjpm.toolchain.CjToolchainProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="cn.cangnova.cangjie.toolchainFlavor"
                        interface="cn.cangnova.cangjie.cjpm.toolchain.flavors.CjToolchainFlavor"
                        dynamic="true"/>
        <!--        psi查找-->
        <extensionPoint qualifiedName="cn.cangnova.cangjie.psi.elementFinder" dynamic="true"
                        area="IDEA_PROJECT" interface="cn.cangnova.cangjie.psi.CangJiePsiElementFinderBase"/>
        <!--分析之前高亮-->
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.beforeResolveHighlightingVisitor"
                interface="cn.cangnova.cangjie.highlighter.BeforeResolveHighlightingExtension"
                dynamic="true"/>
        <!--        诊断抑制-->
        <extensionPoint qualifiedName="cn.cangnova.cangjie.diagnosticSuppressor"
                        interface="cn.cangnova.cangjie.descriptors.DiagnosticSuppressor"
                        dynamic="true"/>
        <!--        Cjpm 运行配置-->
        <extensionPoint qualifiedName="cn.cangnova.cangjie.runConfigurationExtension"
                        interface="cn.cangnova.cangjie.ide.run.cjpm.runconfig.CjpmCommandConfigurationExtension"
                        dynamic="true"/>
        <!--文件被创建后的处理-->
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.newFileHook"
                interface="cn.cangnova.cangjie.ide.actions.NewCangJieFileHook"
                dynamic="true"/>
        <!--         项目配置-->
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.projectConfigurator"
                interface="cn.cangnova.cangjie.ide.configuration.CangJieProjectConfigurator"
                dynamic="true"/>
        <!--        模块信息提供者-->
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.moduleinfo.moduleInfoProviderExtension"
                interface="cn.cangnova.cangjie.ide.projectStructure.ModuleInfoProviderExtension"
                area="IDEA_PROJECT"
                dynamic="true"/>
        <!--        解析范围-->
        <extensionPoint qualifiedName="cn.cangnova.cangjie.resolveScopeEnlarger"
                        dynamic="true"
                        interface="cn.cangnova.cangjie.ide.projectStructure.CangJieResolveScopeEnlarger"/>
        <!--        类导入过滤器-->
        <extensionPoint
                qualifiedName="cn.cangnova.cangjie.classImportFilter"
                interface="cn.cangnova.cangjie.ide.util.ClassImportFilter"
                dynamic="true"/>
        <!--        简单名称引用扩展点-->
        <extensionPoint qualifiedName="cn.cangnova.cangjie.simpleNameReferenceExtension"
                        interface="cn.cangnova.cangjie.references.SimpleNameReferenceExtension"
                        area="IDEA_PROJECT" dynamic="true"/>


        <extensionPoint qualifiedName="cn.cangnova.cangjie.classFileDecompiler"
                        interface="cn.cangnova.cangjie.psi.compiled.ClassFileDecompilers$Decompiler"
                        dynamic="true"/>

        <extensionPoint qualifiedName="cn.cangnova.cangjie.sdkDownload"
                        interface="cn.cangnova.cangjie.ide.projectStructure.download.SdkDownloadEp"/>

        <extensionPoint qualifiedName="cn.cangnova.cangjie.ide.turboComplete.suggestionGeneratorExecutorProvider"
                        interface="cn.cangnova.cangjie.ide.completion.turboComplete.SuggestionGeneratorExecutorProvider"
                        dynamic="true"

        />

    </extensionPoints>


    <actions>


        <action id="GeneratedBuiltins" class="cn.cangnova.cangjie.ide.actions.GeneratedBuiltins"
                text="生成Builtins文件" description="GeneratedBuiltins">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="CjpmRunMain" class="cn.cangnova.cangjie.ide.run.cjpm.RunMainAction"/>

        <action id="CangJie.NewFile" class="cn.cangnova.cangjie.ide.actions.NewCangJieFileAction"
                text="Add Cangjie File"
                icon="cn.cangnova.cangjie.icon.CangJieIcons.CANGJIE">


            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="NewGroup1"/>
        </action>


        <!--        CJPM-->

        <action id="Cjpm.AttachCjpmProject"
                class="cn.cangnova.cangjie.cjpm.project.model.AttachCjpmProjectAction"
                icon="AllIcons.General.Add"/>

        <!--        更新cjpm项目结构-->
        <action id="Cjpm.RefreshCjpmProject"
                class="cn.cangnova.cangjie.ide.actions.RefreshCjpmProjectsAction"
                icon="AllIcons.Actions.Refresh"/>

        <action id="Cjpm.ShowSettings"
                class="cn.cangnova.cangjie.ide.actions.CjpmEditSettingsAction"
                icon="AllIcons.General.Settings">
        </action>


        <action id="Cjpm.RunCjpmCommand"
                class="cn.cangnova.cangjie.cjpm.runconfig.command.RunCjpmCommandAction"
        />
        <group id="CangJie.Cjpm">
            <reference id="Cjpm.RefreshCjpmProject"/>
            <reference id="Cjpm.AttachCjpmProject"/>
            <!--            <reference id="Cjpm.DetachCjpmProject"/>-->
            <separator/>
            <reference id="Cjpm.RunCjpmCommand"/>
            <!--            <reference id="Cjpm.RunExternalLinter"/>-->
            <!--            <reference id="Cjpm.CangJiefmtCjpmProject"/>-->
            <separator/>
            <reference id="ExpandAll"/>
            <reference id="CollapseAll"/>
            <separator/>
            <reference id="Cjpm.ShowSettings"/>
        </group>

    </actions>


    <!--    <extensions defaultExtensionNs="com.jetbrains">-->
    <!--        <performancePlugin.commandProvider implementation="cn.cangnova.cangjie.ide.performancePlugin.CangJiePluginCommandProvider"/>-->
    <!--    </extensions>-->


    <extensions defaultExtensionNs="com.intellij">

        <internalFileTemplate name="CangJie Class"/>

    </extensions>

    <extensions defaultExtensionNs="lsp">

        <!-- LSP -->
        <!--        <serverSupportProvider implementation="cn.cangnova.cangjie.lang.lsp.CangJieLspServerSupportProvider"/>-->


    </extensions>


    <extensions defaultExtensionNs="cn.cangnova.cangjie">
        <!-- Toolchains -->
        <toolchainFlavor id="cangjie.cjpmToolchainFlavor"
                         implementation="cn.cangnova.cangjie.cjpm.toolchain.flavors.CjpmToolchainFlavor"
                         order="first"/>
        <toolchainFlavor id="cangjie.winToolchainFlavor"
                         implementation="cn.cangnova.cangjie.cjpm.toolchain.flavors.CjWinToolchainFlavor"/>

        <toolchainProvider implementation="cn.cangnova.cangjie.cjpm.toolchain.CjLocalToolchainProvider"/>
        <psi.elementFinder implementation="cn.cangnova.cangjie.psi.CjpmProjectPsiElementFinder" id="CjpmProject"
                           order="first"/>
        <psi.elementFinder implementation="cn.cangnova.cangjie.psi.CjpmPackagePsiElementFinder" id="CjpmPackage"
                           order="first"/>
        <psi.elementFinder implementation="cn.cangnova.cangjie.psi.CjpmStdlibPsiElementFinder" id="CjpmStdlib"
                           order="first"/>


        <toolchainFlavor id="cangjie.wslToolchainFlavor"
                         implementation="cn.cangnova.cangjie.cjpm.toolchain.wsl.CjWslToolchainFlavor"/>

        <moduleinfo.moduleInfoProviderExtension
                implementation="cn.cangnova.cangjie.ide.projectStructure.DefaultModuleInfoProviderExtension"/>


        <sdkDownload implementation="cn.cangnova.cangjie.ide.projectStructure.download.SdkDownloader"/>


    </extensions>

</idea-plugin>
