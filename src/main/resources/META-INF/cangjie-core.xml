        <newProjectWizard.language
                implementation="com.huawei.cangjie.idea.project.tools.projectWizard.CangJieNewProjectWizard"/>
        <moduleBuilder
                builderClass="com.huawei.cangjie.idea.project.tools.projectWizard.wizard.CangJieModuleBuilder"/>


        <!--运行-->
