<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude" allow-bundled-update="true">
    <resource-bundle>messages.CjBundle</resource-bundle>

    <depends>com.intellij.modules.lang</depends>

    <extensions defaultExtensionNs="com.intellij">



        <!--文件类型工厂 -->

        <fileType name="CangJie"
                  language="CangJie"
                  implementationClass="com.huawei.cangjie.lang.CjFileType"
                  extensions="cj"
                  fieldName="INSTANCE"/>
        <!--        <internalFileTemplate name="CangJie File"/>-->

        <!-- 分析 -->

        <lang.parserDefinition language="CangJie"
                               implementationClass="com.huawei.cangjie.lang.core.parser.CangJieParserDefinition"/>
        <stubElementTypeHolder class="com.huawei.cangjie.lang.core.psi.CjElementTypes" externalIdPrefix="cangjie."/>



        <!-- PSI 管理器 -->

        <lang.fileViewProviderFactory language="CangJie" implementationClass="com.huawei.cangjie.lang.core.psi.CjFileViewProviderFactory"/>
        <projectService serviceInterface="com.huawei.cangjie.lang.core.psi.CjPsiManager"
                        serviceImplementation="com.huawei.cangjie.lang.core.psi.CjPsiManagerImpl"/>



        <annotator language="CangJie" implementationClass="com.huawei.cangjie.ide.annotator.CjErrorAnnotator"/>
        <highlightRangeExtension implementation="com.huawei.cangjie.ide.annotator.CjErrorAnnotator"/>
    </extensions>

</idea-plugin>
