<idea-plugin>
    <extensionPoints>
        <extensionPoint
                name="toolchainProvider"
                qualifiedName="cn.cangnova.cangjie.toolchain.toolchainProvider"
                interface="cn.cangnova.cangjie.toolchain.api.CjToolchainProvider"
                dynamic="true"/>
        <extensionPoint
                name="toolFactory"
                qualifiedName="cn.cangnova.cangjie.toolchain.toolFactory"

                interface="cn.cangnova.cangjie.toolchain.api.CjToolFactory"
                dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="cn.cangnova.cangjie.toolchain">
        <toolchainProvider implementation="cn.cangnova.cangjie.toolchain.impl.OfficialCjToolchainProvider"/>
        <!-- 如有其它 provider 也在此注册 -->
        <!-- <toolFactory implementation="cn.cangnova.cangjie.toolchain.impl.YourToolFactoryImpl"/> -->
    </extensions>
</idea-plugin>
