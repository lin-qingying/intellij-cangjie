{
  parserClass="org.cangnova.cangjie.parser.CangJieParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="CangJie"
  psiImplClassSuffix="Impl"
  psiPackage="org.cangnova.cangjie.psi"
  psiImplPackage="org.cangnova.cangjie.psi.impl"

  elementTypeHolderClass="org.cangnova.cangjie.psi.CangJieTypes"
  elementTypeClass="org.cangnova.cangjie.psi.CangJieElementType"
  tokenTypeClass="org.cangnova.cangjie.psi.CangJieTokenType"

  tokens=[
    LT='<'
    GT='>'
    COMMA=','
    CLASS='class'
    UPPERBOUND='extends'
  ]
}

TYPE_PARAMETERS ::= LT IDENTIFIER TYPE_PARAMETERS_LIST? GT
TYPE_PARAMETERS_LIST ::= COMMA IDENTIFIER TYPE_PARAMETERS_LIST?

CLASS_DEFINITION ::= CLASS_MODIFIER_LIST? CLASS IDENTIFIER TYPE_PARAMETERS? CLASS_INHERITANCE? GENERIC_CONSTRAINTS? CLASS_BODY

private CLASS_INHERITANCE ::= UPPERBOUND SUPER_CLASS_OR_INTERFACES
