<idea-plugin package="cn.cangnova.cangjie.lsp4ij">

    <module value="cn.cangnova.cangjie.lsp4ij"/>
    <dependencies>

        <plugin id="com.redhat.devtools.lsp4ij"/>
    </dependencies>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <languageMapping language="CangJie" serverId="CangJie"/>
        <server factoryClass="cn.cangnova.cangjie.lsp4ij.CangJieLanguageServerFactory" id="CangJie"/>
        <semanticTokensColorsProvider serverId="CangJie"/>
        <!--   <fileTypeMapping fileType="CangJieFileType" serverId="CangJie"/>-->
    </extensions>

</idea-plugin>