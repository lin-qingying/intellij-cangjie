<idea-plugin>
    <!-- 扩展点定义 -->
    <extensionPoints>
        <!-- 项目提供者:识别和创建项目 -->
        <extensionPoint
                name="projectProvider"
                qualifiedName="org.cangnova.cangjie.project.projectProvider"
                interface="org.cangnova.cangjie.project.extension.CjProjectProvider"
                dynamic="true"/>

        <!-- 配置解析器:解析项目配置文件 -->
        <extensionPoint
                name="configParser"
                qualifiedName="org.cangnova.cangjie.project.configParser"
                interface="org.cangnova.cangjie.project.extension.CjProjectConfigParser"
                dynamic="true"/>


        <!-- 命令提供者:提供仓颉项目相关的命令执行功能 -->
        <extensionPoint
                name="commandProvider"
                qualifiedName="org.cangnova.cangjie.commandProvider"
                interface="org.cangnova.cangjie.project.ui.actions.CjCommandProvider"
                dynamic="true"/>

        <!-- 模块构建器提供者:提供新项目创建的 ModuleBuilder -->
        <extensionPoint
                name="moduleBuilderProvider"
                qualifiedName="org.cangnova.cangjie.project.moduleBuilderProvider"
                interface="org.cangnova.cangjie.project.extension.CjModuleBuilderProvider"
                dynamic="true"/>

        <!-- 构建系统标识符:定义构建系统、项目模块和依赖管理的统一标识 -->
        <extensionPoint
                name="buildSystemId"
                qualifiedName="org.cangnova.cangjie.project.buildSystemId"
                interface="org.cangnova.cangjie.project.extension.ProjectBuildSystemId"
                dynamic="true"/>

        <!-- 命令执行器:子系统提供命令执行逻辑 -->
        <extensionPoint
                name="commandExecutor"
                qualifiedName="org.cangnova.cangjie.run.commandExecutor"
                interface="org.cangnova.cangjie.run.CangJieCommandExecutor"
                dynamic="true"/>

        <!-- 项目任务运行器:子系统提供构建任务执行逻辑 -->
        <extensionPoint
                name="projectTaskRunner"
                qualifiedName="org.cangnova.cangjie.run.projectTaskRunner"
                interface="org.cangnova.cangjie.run.CangJieProjectTaskRunner"
                dynamic="true"/>

        <!-- 运行配置扩展:允许插件扩展运行配置行为 -->
        <extensionPoint
                name="runConfigurationExtension"
                qualifiedName="org.cangnova.cangjie.run.runConfigurationExtension"
                interface="org.cangnova.cangjie.run.CangJieRunConfigurationExtension"
                dynamic="true"/>

        <!-- 构建输出解析器:允许不同构建系统提供自己的输出解析逻辑 -->
        <extensionPoint
                name="buildOutputParser"
                qualifiedName="org.cangnova.cangjie.run.buildOutputParser"
                interface="org.cangnova.cangjie.run.CangJieBuildOutputParser"
                dynamic="true"/>

    </extensionPoints>

    <!-- 服务注册 -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- 运行配置 -->
        <!-- 运行配置类型 - 命令配置 -->
        <configurationType
                implementation="org.cangnova.cangjie.run.CangJieCommandRunConfigurationType"
                id="CangJieCommandRunConfigurationType"/>

        <!-- 运行配置类型 - 程序配置 -->
        <configurationType
                implementation="org.cangnova.cangjie.run.CangJieProgramRunConfigurationType"
                id="CangJieProgramRunConfigurationType"/>

        <!-- 运行配置生成器 -->
        <runConfigurationProducer
                implementation="org.cangnova.cangjie.run.CangJieRunConfigurationProducer"
                id="CangJieRunConfigurationProducer"/>

        <!-- 程序运行配置生成器 -->
        <runConfigurationProducer
                implementation="org.cangnova.cangjie.run.CangJieProgramRunConfigurationProducer"
                id="CangJieProgramRunConfigurationProducer"/>

        <!-- 程序运行器 -->
        <programRunner
                implementation="org.cangnova.cangjie.run.CangJieProgramRunner"
                id="CangJieProgramRunner"/>
        <programRunner
                implementation="org.cangnova.cangjie.run.CangJieCommondRunner"
                id="CangJieProgramRunner"/>

        <!--    行配置之前执行的步骤   -->
        <stepsBeforeRunProvider
                implementation="org.cangnova.cangjie.run.build.CangJieBuildTaskProvider"/>

        <!-- 远程目标环境支持 -->
        <executionTargetLanguageRuntimeType
                implementation="org.cangnova.cangjie.run.target.CjLanguageRuntimeType"/>

        <!-- 项目任务运行器 -->
        <projectTaskRunner
                implementation="org.cangnova.cangjie.run.CangJieBuildTaskRunner"
                id="CangJieBuildTaskRunner"
                order="first"/>

        <!-- 项目级服务: 构建会话队列管理器 -->
        <projectService
                serviceImplementation="org.cangnova.cangjie.run.CangJieBuildSessionsQueueManager"/>

        <!-- 通知组 -->
        <notificationGroup
                id="CangJie Build"
                displayType="BALLOON"/>

        <!-- 项目级服务: 项目管理服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.project.service.CjProjectsService"
                serviceImplementation="org.cangnova.cangjie.project.service.impl.CjProjectsServiceImpl"/>


        <!-- 工具窗口: 显示仓颉项目结构 -->
        <toolWindow
                id="CangJie Projects"
                factoryClass="org.cangnova.cangjie.project.ui.toolwindow.CjProjectToolWindowFactory"
                anchor="right"
                icon="AllIcons.Nodes.Module"/>

        <!-- RunAnything 提供者: 统一的命令执行入口 -->
        <runAnything.executionProvider
                order="after RunAnythingRunConfigurationProvider"
                implementation="org.cangnova.cangjie.project.ui.actions.CjRunAnythingProviderImpl"/>

        <registryKey key="org.cangnova.cangjie.project.new.auto.import"
                     defaultValue="true"
                     description="Enable new project model reloading"
                     restartRequired="true"/>

        <!-- 额外的库根目录提供者: 为 IDE 提供仓颉项目的可索引目录 -->
<!--        <additionalLibraryRootsProvider-->
<!--                implementation="org.cangnova.cangjie.project.roots.CangJieAdditionalLibraryRootsProvider"/>-->
    </extensions>

    <projectListeners>
        <!-- Cangjie项目配置监听器 -->
        <listener class="org.cangnova.cangjie.project.listener.CjProjectConfigurationListener"
                  topic="org.cangnova.cangjie.project.event.CjProjectListener"/>

        <listener class="org.cangnova.cangjie.ide.status.CjExternalLinterWidgetUpdater"
                  topic="cn.cangnova.cangjie.cjpm.project.model.CjpmProjectsService$CjpmProjectsListener"/>
    </projectListeners>

    <!-- 动作定义 -->
    <actions>

        <!-- 仓颉项目相关动作 -->

        <!-- 刷新仓颉项目的动作
             扩展类型: CangJieProjectActionBase -->
        <action id="CjProject.RefreshProject"
                class="org.cangnova.cangjie.project.ui.actions.RefreshProjectAction"
                text="Refresh Projects"
                icon="AllIcons.Actions.Refresh"/>

        <!-- 附加仓颉项目的动作
             扩展类型: CangJieProjectActionBase -->
<!--        <action id="CjProject.AttachProject"-->
<!--                class="org.cangnova.cangjie.project.ui.actions.AttachProjectAction"-->
<!--                text="Attach CangJie Project"-->
<!--                icon="AllIcons.General.Add"/>-->

        <!-- 运行仓颉命令的动作
             扩展类型: CangJieProjectActionBase -->
        <action id="CjProject.RunCommand"
                class="org.cangnova.cangjie.project.ui.actions.RunCommandAction"
                text="Run CJPM Command"
                icon="AllIcons.Actions.Execute"/>

        <!-- 显示仓颉设置的动作
             扩展类型: CangJieProjectActionBase -->
<!--        <action id="CjProject.ShowSettings"-->
<!--                class="org.cangnova.cangjie.project.ui.actions.ShowSettingsAction"-->
<!--                text="CangJie Settings"-->
<!--                icon="AllIcons.General.Settings"/>-->


        <group id="CangJie.CjProject">
            <reference ref="CjProject.RefreshProject"/>

            <separator/>
            <reference ref="CjProject.RunCommand"/>

            <separator/>
            <reference ref="ExpandAll"/>
            <reference ref="CollapseAll"/>
            <separator/>

        </group>
    </actions>
</idea-plugin>