<idea-plugin>
    <!-- 扩展点定义 -->
    <extensionPoints>
        <!-- 项目提供者:识别和创建项目 -->
        <extensionPoint
                name="projectProvider"
                qualifiedName="org.cangnova.cangjie.project.projectProvider"
                interface="org.cangnova.cangjie.project.extension.CjProjectProvider"
                dynamic="true"/>

        <!-- 配置解析器:解析项目配置文件 -->
        <extensionPoint
                name="configParser"
                qualifiedName="org.cangnova.cangjie.project.configParser"
                interface="org.cangnova.cangjie.project.extension.CjProjectConfigParser"
                dynamic="true"/>

        <!-- 项目打开处理器:处理项目打开逻辑 -->
        <extensionPoint
                name="projectOpenProcessor"
                qualifiedName="org.cangnova.cangjie.project.projectOpenProcessor"
                interface="org.cangnova.cangjie.project.extension.CjProjectOpenProcessor"
                dynamic="true"/>

        <!-- 模块构建器提供者:提供新项目创建的 ModuleBuilder -->
        <extensionPoint
                name="moduleBuilderProvider"
                qualifiedName="org.cangnova.cangjie.project.moduleBuilderProvider"
                interface="org.cangnova.cangjie.project.extension.CjModuleBuilderProvider"
                dynamic="true"/>
    </extensionPoints>

    <!-- 服务注册 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 项目级服务: 项目管理服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.project.service.CjProjectsService"
                serviceImplementation="org.cangnova.cangjie.project.service.impl.CjProjectsServiceImpl"/>

        <!-- 工具窗口: 显示仓颉项目结构 -->
        <toolWindow
                id="CangJie Projects"
                factoryClass="org.cangnova.cangjie.project.ui.toolwindow.CjProjectToolWindowFactory"
                anchor="right"
                icon="AllIcons.Nodes.Module"/>
    </extensions>

    <!-- 动作定义 -->
    <actions>
        <!-- 仓颉项目工具窗口工具栏动作组 -->
        <group id="CangJie.CjProject"
               class="com.intellij.openapi.actionSystem.DefaultActionGroup">
            <!-- 未来在这里添加工具栏动作 -->
        </group>
    </actions>
</idea-plugin>