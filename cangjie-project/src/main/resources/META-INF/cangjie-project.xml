<idea-plugin>
    <!-- 扩展点定义 -->
    <extensionPoints>
        <!-- 项目提供者:识别和创建项目 -->
        <extensionPoint
                name="projectProvider"
                qualifiedName="org.cangnova.cangjie.project.projectProvider"
                interface="org.cangnova.cangjie.project.extension.CjProjectProvider"
                dynamic="true"/>

        <!-- 配置解析器:解析项目配置文件 -->
        <extensionPoint
                name="configParser"
                qualifiedName="org.cangnova.cangjie.project.configParser"
                interface="org.cangnova.cangjie.project.extension.CjProjectConfigParser"
                dynamic="true"/>

        <!-- 项目打开处理器:处理项目打开逻辑 -->
        <extensionPoint
                name="projectOpenProcessor"
                qualifiedName="org.cangnova.cangjie.project.projectOpenProcessor"
                interface="org.cangnova.cangjie.project.extension.CjProjectOpenProcessor"
                dynamic="true"/>

        <!-- 模块构建器提供者:提供新项目创建的 ModuleBuilder -->

        <!-- 命令提供者:提供仓颉项目相关的命令执行功能 -->
        <extensionPoint
                name="commandProvider"
                qualifiedName="org.cangnova.cangjie.commandProvider"
                interface="org.cangnova.cangjie.project.ui.actions.CjCommandProvider"
                dynamic="true"/>
        <extensionPoint
                name="moduleBuilderProvider"
                qualifiedName="org.cangnova.cangjie.project.moduleBuilderProvider"
                interface="org.cangnova.cangjie.project.extension.CjModuleBuilderProvider"
                dynamic="true"/>
    </extensionPoints>

    <!-- 服务注册 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 项目级服务: 项目管理服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.project.service.CjProjectsService"
                serviceImplementation="org.cangnova.cangjie.project.service.impl.CjProjectsServiceImpl"/>

        <!-- 工具窗口: 显示仓颉项目结构 -->
        <toolWindow
                id="CangJie Projects"
                factoryClass="org.cangnova.cangjie.project.ui.toolwindow.CjProjectToolWindowFactory"
                anchor="right"
                icon="AllIcons.Nodes.Module"/>


        <registryKey key="org.cangnova.cangjie.project.new.auto.import"
                     defaultValue="true"
                     description="Enable new project model reloading"
                     restartRequired="true"/>
    </extensions>

    <projectListeners>


        <listener class="org.cangnova.cangjie.ide.status.CjExternalLinterWidgetUpdater"
                  topic="cn.cangnova.cangjie.cjpm.project.model.CjpmProjectsService$CjpmProjectsListener"/>
    </projectListeners>

    <!-- 动作定义 -->
    <actions>

        <!-- 仓颉项目相关动作 -->

        <!-- 刷新仓颉项目的动作
             扩展类型: CangJieProjectActionBase -->
        <action id="CjProject.RefreshProject"
                class="org.cangnova.cangjie.project.ui.actions.RefreshProjectAction"
                text="Refresh Projects"
                icon="AllIcons.Actions.Refresh"/>

        <!-- 附加仓颉项目的动作
             扩展类型: CangJieProjectActionBase -->
        <action id="CjProject.AttachProject"
                class="org.cangnova.cangjie.project.ui.actions.AttachProjectAction"
                text="Attach CangJie Project"
                icon="AllIcons.General.Add"/>

        <!-- 运行仓颉命令的动作
             扩展类型: CangJieProjectActionBase -->
        <action id="CjProject.RunCommand"
                class="org.cangnova.cangjie.project.ui.actions.RunCommandAction"
                text="Run CJPM Command"
                icon="AllIcons.Actions.Execute"/>

        <!-- 显示仓颉设置的动作
             扩展类型: CangJieProjectActionBase -->
<!--        <action id="CjProject.ShowSettings"-->
<!--                class="org.cangnova.cangjie.project.ui.actions.ShowSettingsAction"-->
<!--                text="CangJie Settings"-->
<!--                icon="AllIcons.General.Settings"/>-->


        <group id="CangJie.CjProject">
            <reference id="CjProject.RefreshProject"/>
            <reference id="CjProject.AttachProject"/>

            <separator/>
            <reference id="CjProject.RunCommand"/>

            <separator/>
            <reference id="ExpandAll"/>
            <reference id="CollapseAll"/>
            <separator/>
<!--            <reference id="CjProject.ShowSettings"/>-->
        </group>
    </actions>
</idea-plugin>