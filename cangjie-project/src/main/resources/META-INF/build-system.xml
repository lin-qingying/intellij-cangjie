<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Project-level services -->
        <projectService
                serviceInterface="org.cangnova.cangjie.build.service.CjBuildTaskManager"
                serviceImplementation="org.cangnova.cangjie.build.service.impl.CjBuildTaskManagerImpl"/>
    </extensions>

    <extensionPoints>
        <!-- Build System Provider Extension Point -->
        <extensionPoint
                name="buildSystemProvider"
                qualifiedName="org.cangnova.cangjie.build.buildSystemProvider"
                interface="org.cangnova.cangjie.build.extension.CjBuildSystemProvider"
                dynamic="true"/>

        <!-- Build Task Executor Extension Point -->
        <extensionPoint
                name="buildTaskExecutor"
                qualifiedName="org.cangnova.cangjie.build.buildTaskExecutor"
                interface="org.cangnova.cangjie.build.extension.CjBuildTaskExecutor"
                dynamic="true"/>

        <!-- Build Configuration Provider Extension Point -->
        <extensionPoint
                name="buildConfigurationProvider"
                qualifiedName="org.cangnova.cangjie.build.buildConfigurationProvider"
                interface="org.cangnova.cangjie.build.extension.CjBuildConfigurationProvider"
                dynamic="true"/>
    </extensionPoints>
</idea-plugin>