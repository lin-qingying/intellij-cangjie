<ide-plugin>
    <!-- 扩展点定义 -->
    <extensionPoints>
        <!-- 模块信息提供者扩展 -->
        <extensionPoint
                qualifiedName="org.cangnova.cangjie.moduleInfoProviderExtension"
                interface="org.cangnova.cangjie.moduleinfo.provider.ModuleInfoProviderExtension"
                area="IDEA_PROJECT"
                dynamic="true"/>


        <!-- 分析上下文提供者扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.analysisContextProvider"
                        interface="org.cangnova.cangjie.descriptors.AnalysisContextProvider"
                        dynamic="true"/>

        <!-- 解析优化选项提供者扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.caches.resolve.resolveOptimizingOptionsProvider"
                        interface="org.cangnova.cangjie.resolve.caches.ResolveOptimizingOptionsProvider"
                        dynamic="true"/>

        <!-- 类型属性转换器扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.typeAttributeTranslatorExtension"
                        interface="org.cangnova.cangjie.extensions.TypeAttributeTranslatorExtension"
                        dynamic="true"/>

        <!-- 存储组件容器贡献者扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.storageComponentContainerContributor"
                        interface="org.cangnova.cangjie.extensions.StorageComponentContainerContributor"
                        dynamic="true"/>

        <!-- 合成解析扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.syntheticResolveExtension"
                        interface="org.cangnova.cangjie.resolve.extensions.SyntheticResolveExtension"
                        dynamic="true"/>

        <!-- 仓颉索引助手扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.cangjieIndicesHelperExtension"
                        interface="org.cangnova.cangjie.extensions.CangJieIndicesHelperExtension"
                        dynamic="true"/>

        <!-- 收集额外源文件扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.collectAdditionalSourcesExtension"
                        interface="org.cangnova.cangjie.extensions.CollectAdditionalSourcesExtension"
                        dynamic="true"/>

        <!-- 声明属性修改器扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.declarationAttributeAltererExtension"
                        interface="org.cangnova.cangjie.extensions.DeclarationAttributeAltererExtension"
                        dynamic="true"/>

        <!-- 编译前处理源文件扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.processSourcesBeforeCompiling"
                        interface="org.cangnova.cangjie.extensions.ProcessSourcesBeforeCompilingExtension"
                        dynamic="true"/>

        <!-- 调用解析拦截器扩展点（内部非稳定） -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.extensions.internal.callResolutionInterceptorExtension"
                        interface="org.cangnova.cangjie.extensions.internal.CallResolutionInterceptorExtension"
                        dynamic="true"/>

        <!-- 类型解析拦截器扩展点（内部非稳定） -->
        <extensionPoint qualifiedName="org.jetbrains.CangJie.extensions.internal.typeResolutionInterceptorExtension"
                        interface="org.cangnova.cangjie.extensions.internal.TypeResolutionInterceptorExtension"
                        dynamic="true"/>

        <!-- 额外导入提供者扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.extraImportsProviderExtension"
                        interface="org.cangnova.cangjie.resolve.extensions.ExtraImportsProviderExtension"
                        dynamic="true"/>

        <!-- 诊断抑制器扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.diagnosticSuppressor"
                        interface="org.cangnova.cangjie.analysis.DiagnosticSuppressor"
                        dynamic="true"/>

        <!-- 快速修复贡献者扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.quickFixContributor"
                        interface="org.cangnova.cangjie.quickfix.QuickFixContributor"
                        dynamic="true"/>

        <extensionPoint qualifiedName="org.cangnova.cangjie.classFileDecompiler"
                        interface="org.cangnova.cangjie.decompiler.psi.compiled.ClassFileDecompilers$Decompiler"
                        dynamic="true"/>

        <!-- 解析范围扩展器扩展点 -->
        <extensionPoint qualifiedName="org.cangnova.cangjie.resolveScopeEnlarger"
                        interface="org.cangnova.cangjie.resolve.CangJieResolveScopeEnlarger"
                        dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">

        <!-- 模块信息提供者服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.moduleinfo.provider.ModuleInfoProvider"
                serviceImplementation="org.cangnova.cangjie.moduleinfo.provider.ModuleInfoProvider"/>

        <!-- 库信息缓存服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.moduleinfo.cache.LibraryInfoCache"
                serviceImplementation="org.cangnova.cangjie.moduleinfo.cache.LibraryInfoCache"/>
        <!-- 库依赖缓存服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.moduleinfo.cache.LibraryDependenciesCache"
                serviceImplementation="org.cangnova.cangjie.moduleinfo.cache.LibraryDependenciesCacheImpl"/>
        <!-- 库使用索引服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.moduleinfo.LibraryUsageIndex"
                serviceImplementation="org.cangnova.cangjie.moduleinfo.LibraryUsageIndexImpl"/>
        <!-- 模块信息缓存服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.moduleinfo.cache.IdeaModelInfosCache"
                serviceImplementation="org.cangnova.cangjie.moduleinfo.cache.FineGrainedIdeaModelInfosCache"/>

        <!-- 模块修改追踪服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.moduleinfo.util.ModuleModificationTracker"
                serviceImplementation="org.cangnova.cangjie.moduleinfo.util.ModuleModificationTracker"/>

        <!-- 诊断系统初始化启动活动 -->
        <postStartupActivity implementation="org.cangnova.cangjie.diagnostics.DiagnosticInitializerStartupActivity"/>

        <!-- Registry keys for cache configuration -->
        <registryKey key="cangjie.caches.fine.grained.entity.validation"
                     description="Enable validation checks for fine-grained entity caches"
                     defaultValue="false"/>
        <registryKey key="cangjie.caches.fine.grained.throttling.timeout.ms"
                     description="Throttling timeout in milliseconds for fine-grained cache invalidation"
                     defaultValue="0"/>
        <registryKey key="cangjie.highlighting.suppress.deprecated"
                     description="Suppress cangjie.Deprecated warning"
                     defaultValue="false"/>
        <applicationService
                serviceInterface="org.cangnova.cangjie.decompiler.psi.CangJieBuiltInDecompilationInterceptor"
                serviceImplementation="org.cangnova.cangjie.decompiler.psi.IdeCangJieBuiltInDecompilationInterceptor"
        />
        <applicationService serviceInterface="org.cangnova.cangjie.decompiler.psi.BuiltinsVirtualFileProvider"
                        serviceImplementation="org.cangnova.cangjie.decompiler.psi.IdeBuiltInsVirtualFileProviderImpl"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.highlighter.CangJieQuickFixProvider"
                serviceImplementation="org.cangnova.cangjie.highlighter.CangJieQuickFixProviderImpl"/>


        <highlightVisitor implementation="org.cangnova.cangjie.analysis.CangJieHighlightVisitor"/>



        <projectService
                serviceInterface="org.cangnova.cangjie.projectStructure.RootKindMatcher"
                serviceImplementation="org.cangnova.cangjie.projectStructure.RootKindMatcherImpl"/>
        <projectService
                serviceInterface="org.cangnova.cangjie.resolve.caches.CangJieCacheService"
                serviceImplementation="org.cangnova.cangjie.resolve.caches.CangJieCacheServiceImpl"/>
        <projectService
                serviceInterface="org.cangnova.cangjie.cache.trackers.ModuleDependencyProviderExtension"
                serviceImplementation="org.cangnova.cangjie.cache.trackers.ResolutionAnchorModuleDependencyProviderExtension"/>

        <!-- 额外服务注册 -->
        <!-- 应用级服务 -->
        <applicationService
                serviceInterface="org.cangnova.cangjie.references.CjReferenceMutateService"
                serviceImplementation="org.cangnova.cangjie.references.rename.CangJieReferenceMutateService"/>

        <applicationService
                serviceInterface="org.cangnova.cangjie.decompiler.psi.CangJieBuiltInStubVersionOffsetProvider"
                serviceImplementation="org.cangnova.cangjie.decompiler.psi.IdeCangJieBuiltInStubVersionOffsetProvider"/>

        <applicationService
                serviceInterface="org.cangnova.cangjie.references.CjReferenceResolutionHelper"
                serviceImplementation="org.cangnova.cangjie.references.CjReferenceResolutionHelperImpl"/>

        <!-- 项目级服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.psi.CangJiePsiFacade"
                serviceImplementation="org.cangnova.cangjie.psi.DefaultCangJiePsiFacade"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.resolve.CangJieModificationTrackerService"
                serviceImplementation="org.cangnova.cangjie.resolve.CangJieModificationTrackerService"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.cache.trackers.CangJieIDEModificationTrackerService"
                serviceImplementation="org.cangnova.cangjie.cache.trackers.CangJieIDEModificationTrackerService"/>




        <projectService
                serviceInterface="org.cangnova.cangjie.resolve.LanguageSettingsProvider"
                serviceImplementation="org.cangnova.cangjie.resolve.IDELanguageSettingsProvider"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.ide.cdoc.CDocLinkResolutionService"
                serviceImplementation="org.cangnova.cangjie.ide.cdoc.IdeCDocLinkResolutionService"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.references.ReadWriteAccessChecker"
                serviceImplementation="org.cangnova.cangjie.references.ReadWriteAccessCheckerDescriptorsImpl"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.resolve.lazy.declarations.DeclarationProviderFactoryService"
                serviceImplementation="org.cangnova.cangjie.stubindex.resolve.PluginDeclarationProviderFactoryService"/>
        <projectService
                serviceInterface="org.cangnova.cangjie.resolve.CodeAnalyzerInitializer"
                serviceImplementation="org.cangnova.cangjie.resolve.DummyCodeAnalyzerInitializer"/>

        <lang.documentationProvider language="CangJie"
                                    implementationClass="org.cangnova.cangjie.quickDoc.CangJieDocumentationProvider"
                                    order="first"/>

        <filetype.stubBuilder filetype="cjo" implementationClass="org.cangnova.cangjie.decompiler.psi.compiled.impl.ClassFileStubBuilder"/>
        <filetype.decompiler filetype="cjo" implementationClass="org.cangnova.cangjie.decompiler.psi.compiled.ClassFileDecompiler"/>

    </extensions>

    <!-- 诊断渲染器提供者注册 -->
    <extensions defaultExtensionNs="org.cangnova.cangjie">
        <classFileDecompiler implementation="org.cangnova.cangjie.decompiler.psi.CangJieBuiltInDecompiler"/>

        <!-- 默认诊断渲染器（纯文本格式） -->
        <diagnosticRendererProvider
                implementation="org.cangnova.cangjie.diagnostics.rendering.DefaultRenderers"/>

        <!-- IDE 诊断渲染器（HTML 富文本格式） -->
        <diagnosticRendererProvider
                implementation="org.cangnova.cangjie.diagnostics.rendering.IdeRenderers"/>
    </extensions>

</ide-plugin>