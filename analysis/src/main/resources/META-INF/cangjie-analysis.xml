<ide-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <projectService
                serviceInterface="org.cangnova.cangjie.analysis.decompiler.psi.CangJieBuiltInDecompilationInterceptor"
                serviceImplementation="org.cangnova.cangjie.analysis.decompiler.psi.IdeCangJieBuiltInDecompilationInterceptor"
        />
        <applicationService serviceInterface="org.cangnova.cangjie.analysis.decompiler.psi.BuiltinsVirtualFileProvider"
                        serviceImplementation="org.cangnova.cangjie.analysis.decompiler.psi.IdeBuiltInsVirtualFileProviderImpl"/>

    </extensions>

    <!-- 诊断渲染器提供者注册 -->
    <extensions defaultExtensionNs="org.cangnova.cangjie">
        <diagnosticRendererProvider
                implementation="org.cangnova.cangjie.diagnostics.rendering.errors.ErrorRenderers"/>
        <diagnosticRendererProvider
                implementation="org.cangnova.cangjie.diagnostics.rendering.warnings.WarningRenderers"/>
        <diagnosticRendererProvider
                implementation="org.cangnova.cangjie.diagnostics.rendering.deprecation.DeprecationRenderers"/>
        <diagnosticRendererProvider
                implementation="org.cangnova.cangjie.diagnostics.rendering.infos.InfoRenderers"/>
    </extensions>

</ide-plugin>