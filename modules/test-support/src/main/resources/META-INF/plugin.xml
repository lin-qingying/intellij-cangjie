<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>org.cangnova.cangjie.testSupport</id>
    <name>CangJie Test Support</name>

    <dependencies>
        <plugin id="com.intellij.modules.platform"/>
        <plugin id="com.intellij.modules.json"/>
        <plugin id="org.toml.lang"/>
        <plugin id="com.intellij.copyright"/>
    </dependencies>

    <!--
      test-support 主 source set 只引入自己的模块描述符，让测试环境通过 module 依赖拉起
      foundation / ide.base / domain.* 等插件能力；不要在这里直接聚合生产 descriptor，
      否则当它以 testFixtures 依赖进入产品插件测试时，会把真实产品插件已经装配过的
      application/project services 再注册一遍，导致 InstanceAlreadyRegisteredException。
    -->
    <xi:include href="/org.cangnova.cangjie.testSupport.xml"/>
</idea-plugin>
