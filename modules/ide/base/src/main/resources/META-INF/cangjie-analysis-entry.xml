<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">

<extensionPoints>
    <extensionPoint qualifiedName="org.cangnova.cangjie.cangjieInjectedFilesAnalysisProvider"
                    interface="org.cangnova.cangjie.analysis.CangJieIdeInjectedFilesAnalysisPromoter"
                    dynamic="true"/>
</extensionPoints>


    <extensions defaultExtensionNs="com.intellij">
<!--        <highlightVisitor implementation="org.cangnova.cangjie.highlighter.visitor.CangJieUnusedDeclarationHighlightingVisitor"/>-->

        <highlightRangeExtension implementation="org.cangnova.cangjie.highlighter.visitor.CangJieDiagnosticHighlightVisitor"/>
        <highlightVisitor implementation="org.cangnova.cangjie.highlighter.visitor.CangJieDiagnosticHighlightVisitor"/>




    </extensions>
    <!-- 宿主只负责编排，analysis 实现完全来自上游 -->
    <xi:include href="/META-INF/analysis-api/cangjie-analysis-api-cfir.xml" xpointer="xpointer(/idea-plugin/*)"/>
</idea-plugin>
