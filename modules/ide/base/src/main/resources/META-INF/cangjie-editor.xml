<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <editorSmartKeysConfigurable instance="org.cangnova.cangjie.ide.editor.CangJieEditorOptionsConfigurable"/>

        <lang.foldingBuilder
            language="CangJie"
            implementationClass="org.cangnova.cangjie.ide.editor.folding.CangJieFoldingBuilder"/>

        <typedHandler implementation="org.cangnova.cangjie.ide.editor.CangJieTypedHandler"/>
        <typedHandler implementation="org.cangnova.cangjie.ide.editor.CDocTypedHandler"/>
        <typedHandler implementation="org.cangnova.cangjie.ide.editor.CangJieRawStringTypedHandler"/>

        <backspaceHandlerDelegate implementation="org.cangnova.cangjie.ide.editor.CangJieBackspaceHandlerDelegate"/>
        <backspaceHandlerDelegate implementation="org.cangnova.cangjie.ide.editor.CangJieRawStringBackspaceHandler"/>
        <backspaceHandlerDelegate implementation="org.cangnova.cangjie.ide.editor.CangJieStringTemplateBackspaceHandler"/>

        <lang.braceMatcher
            language="CangJie"
            implementationClass="org.cangnova.cangjie.ide.editor.CangJiePairedBraceMatcher"/>

        <quoteHandler
            fileType="CangJie"
            className="org.cangnova.cangjie.ide.editor.CangJieQuoteHandler"/>

        <lang.commenter
            language="CangJie"
            implementationClass="org.cangnova.cangjie.ide.commenter.CjCommenter"/>

        <platform.backend.documentation.psiTargetProvider
            id="CangJieDocumentationTargetProvider"
            implementation="org.cangnova.cangjie.ide.documentation.CangJiePsiDocumentationTargetProvider"/>

        <platform.backend.documentation.targetProvider
            id="CangJieDocumentationTargetProvider"
            implementation="org.cangnova.cangjie.ide.documentation.CangJieDocumentationTargetProvider"/>

        <platform.backend.documentation.inlineDocumentationProvider
            implementation="org.cangnova.cangjie.ide.documentation.CangJieInlineDocumentationProvider"/>

        <enterHandlerDelegate
            id="CangJieMultilineStringEnterHandler"
            order="before EnterBetweenBracesHandler, before xmlEnter"
            implementation="org.cangnova.cangjie.ide.editor.CangJieMultilineStringEnterHandler"/>
    </extensions>
</idea-plugin>
