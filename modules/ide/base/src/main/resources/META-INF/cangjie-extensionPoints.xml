<idea-plugin>
    <extensionPoints>
        <extensionPoint qualifiedName="org.cangnova.cangjie.cjoProvider"
                        interface="org.cangnova.cangjie.cjo.CjoProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="org.cangnova.cangjie.newFileHook"
                        interface="org.cangnova.cangjie.ide.actions.NewCangJieFileHook"
                        dynamic="true"/>
        <extensionPoint qualifiedName="org.cangnova.cangjie.projectConfigurator"
                        interface="org.cangnova.cangjie.ide.configuration.CangJieProjectConfigurator"
                        dynamic="true"/>
        <extensionPoint qualifiedName="org.cangnova.cangjie.diagnosticRendererProvider"
                        interface="org.cangnova.cangjie.diagnostics.rendering.DiagnosticRendererProvider"
                        dynamic="true"/>
        <extensionPoint qualifiedName="cn.cangnova.cangjie.psi.elementFinder"
                        interface="org.cangnova.cangjie.psi.CangJiePsiElementFinderBase"
                        area="IDEA_PROJECT"
                        dynamic="true"/>
    </extensionPoints>
</idea-plugin>
