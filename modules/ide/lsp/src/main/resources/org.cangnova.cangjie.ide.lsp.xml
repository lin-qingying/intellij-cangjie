<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                instance="org.cangnova.cangjie.configurable.CangJieLanguageServerConfigurable"
                parentId="language.cangjie"
                groupId="language.cangjie"
                id="language.cangjie.languageServer"
                bundle="messages.CangJieBundle"
                key="CangJie.languageServer"/>
        <projectConfigurable
                instance="org.cangnova.cangjie.configurable.CangJieLspConfigurable"
                parentId="language.cangjie.languageServer"
                groupId="language.cangjie"
                id="language.cangjie.languageServer.lsp"
                bundle="messages.CangJieBundle"
                key="CangJie.languageServer.lsp"/>
        <projectConfigurable
                instance="org.cangnova.cangjie.configurable.CangJieAstAnalyzerConfigurable"
                parentId="language.cangjie.languageServer"
                groupId="language.cangjie"
                id="language.cangjie.languageServer.astanalyzer"
                bundle="messages.CangJieBundle"
                key="CangJie.languageServer.astanalyzer"/>
    </extensions>

    <xi:include href="/org.cangnova.cangjie.lsp4ij.xml" xpointer="xpointer(/idea-plugin/*)"/>
</idea-plugin>
