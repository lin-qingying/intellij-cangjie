<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-level services -->
        <!-- External Library Roots Provider: Display dependencies in project view -->
<!--        <additionalLibraryRootsProvider-->
<!--                implementation="org.cangnova.cangjie.dependency.ui.CjDependencyLibraryRootsProvider"/>-->
        <!-- Project-level services -->
        <projectService
                serviceInterface="org.cangnova.cangjie.project.service.CjDependencyService"
                serviceImplementation="org.cangnova.cangjie.project.service.impl.CjDependencyServiceImpl"/>

        <projectService
                serviceInterface="org.cangnova.cangjie.registry.CjPackageRegistry"
                serviceImplementation="org.cangnova.cangjie.registry.impl.CjPackageRegistryImpl"/>
    </extensions>

    <extensionPoints>
        <!-- Dependency Resolver Extension Point -->
        <extensionPoint
                qualifiedName="org.cangnova.cangjie.dependency.dependencyResolver"
                interface="org.cangnova.cangjie.extension.CjDependencyResolver"
                dynamic="true"/>

        <!-- Package Manager Extension Point -->
        <extensionPoint
                qualifiedName="org.cangnova.cangjie.dependency.packageManager"
                interface="org.cangnova.cangjie.extension.CjPackageManager"
                dynamic="true"/>

        <!-- Repository Provider Extension Point -->
        <extensionPoint
                qualifiedName="org.cangnova.cangjie.dependency.repositoryProvider"
                interface="org.cangnova.cangjie.extension.CjRepositoryProvider"
                dynamic="true"/>
    </extensionPoints>
</idea-plugin>
