<idea-plugin>
    <!-- 扩展点定义 -->
    <extensionPoints>
        <!-- SDK 检测器扩展点 -->
        <extensionPoint
                        qualifiedName="org.cangnova.cangjie.toolchain.sdkDetector"
                        interface="org.cangnova.cangjie.toolchain.api.CjSdkDetector"
                        dynamic="true"/>

        <!-- SDK 发现器扩展点 -->
        <extensionPoint
                        qualifiedName="org.cangnova.cangjie.toolchain.sdkDiscoverer"
                        interface="org.cangnova.cangjie.toolchain.api.CjSdkDiscoverer"
                        dynamic="true"/>
    </extensionPoints>

    <!-- 默认扩展实现 -->
    <extensions defaultExtensionNs="org.cangnova.cangjie.toolchain">

        <!-- 默认 SDK 检测器 -->
        <sdkDetector implementation="org.cangnova.cangjie.toolchain.impl.CjSdkDetectorImpl"/>

        <!-- 默认 SDK 发现器 -->
        <sdkDiscoverer implementation="org.cangnova.cangjie.toolchain.impl.CjSdkDiscovererImpl"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 服务定义 -->
        <!-- SDK 注册中心服务 -->
        <applicationService
                serviceInterface="org.cangnova.cangjie.toolchain.api.CjSdkRegistry"
                serviceImplementation="org.cangnova.cangjie.toolchain.impl.CjSdkRegistryImpl"/>

        <!-- 项目 SDK 配置服务 -->
        <projectService
                serviceInterface="org.cangnova.cangjie.toolchain.api.CjProjectSdkConfig"
                serviceImplementation="org.cangnova.cangjie.toolchain.impl.CjProjectSdkConfigImpl"/>
    </extensions>
</idea-plugin>
